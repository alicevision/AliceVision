# syntax=docker/dockerfile:1.4
# vim: ft=dockerfile

# =============================================================================
# Dockerfile_rocky_deps
#
# Builds all AliceVision third-party dependencies on Rocky Linux + CUDA.
# Requires BuildKit:  DOCKER_BUILDKIT=1 docker build ...
#
# Build example:
#   DOCKER_BUILDKIT=1 docker build \
#     --build-arg CUDA_VERSION=12.8.0 \
#     --build-arg ROCKY_VERSION=9 \
#     --tag alicevision/alicevision-deps:<version>-rocky9-cuda12.8.0 \
#     -f docker/Dockerfile_rocky_deps .
# =============================================================================

ARG CUDA_VERSION
ARG ROCKY_VERSION
ARG CMAKE_VERSION=3.31.11

FROM nvidia/cuda:${CUDA_VERSION}-devel-rockylinux${ROCKY_VERSION} AS toolchain
LABEL maintainer="AliceVision Team alicevision-team@googlegroups.com"

# =============================================================================
# System packages + GCC 12 toolset
#
# Single RUN to minimise layers.
# BuildKit cache mount on /var/cache/dnf avoids re-downloading RPMs on rebuild.
#
# gcc-toolset-12 installs into /opt/rh/gcc-toolset-12 — it does NOT own
# /usr/bin/gcc which may already exist as a real file in the CUDA base image.
# We remove it first: Rocky 9 `alternatives` 1.20 has no --force flag.
# =============================================================================
RUN --mount=type=cache,target=/var/cache/dnf \
    dnf install -y --setopt=keepcache=True 'dnf-command(config-manager)' && \
    dnf config-manager --set-enabled devel                              && \
    dnf install -y --setopt=keepcache=True epel-release                 && \
    dnf install -y --setopt=keepcache=True                                 \
        gcc-toolset-12-gcc-c++                                            \
        gcc-toolset-12-gcc-gfortran                                     && \
    rm -f /usr/bin/gcc /usr/bin/g++ /usr/bin/cpp                        && \
    alternatives --install /usr/bin/gcc gcc                               \
        /opt/rh/gcc-toolset-12/root/usr/bin/gcc    60                  && \
    alternatives --install /usr/bin/g++ g++                               \
        /opt/rh/gcc-toolset-12/root/usr/bin/g++    60                  && \
    alternatives --install /usr/bin/cpp cpp                               \
        /opt/rh/gcc-toolset-12/root/usr/bin/cpp    60                  && \
    dnf install -y --setopt=keepcache=True                                 \
        automake                                                          \
        bison                                                             \
        ca-certificates                                                   \
        diffutils                                                         \
        file                                                              \
        git                                                               \
        libasan                                                           \
        libtool                                                           \
        libubsan                                                          \
        openssl-devel                                                     \
        pcre2-devel                                                       \
        texinfo                                                           \
        unzip                                                             \
        wget                                                              \
        which                                                             \
        xerces-c-devel                                                    \
        yaml-cpp                                                          \
        yasm                                                              \
        nasm                                                              \
        zstd                                                              \
        ninja-build

# =============================================================================
# Compiler environment (GCC 12 toolset)
# =============================================================================
ENV PATH="/opt/rh/gcc-toolset-12/root/usr/bin:${PATH}" \
    CC="/opt/rh/gcc-toolset-12/root/usr/bin/gcc"       \
    CXX="/opt/rh/gcc-toolset-12/root/usr/bin/g++"      \
    FC="/opt/rh/gcc-toolset-12/root/usr/bin/gfortran"

RUN gcc --version && g++ --version && gfortran --version

# =============================================================================
# Relocatable release runtime: baseline x86_64 GNU/Linux, glibc >= 2.17.
# Pin version, release and checksum together; never resolve "latest" at build time.
# Use the full archive to retain the upstream licensing texts and metadata.
# This release omits LICENSE.zlib-ng.txt referenced by its metadata; fetch the
# license from the exact dependency tag in its downloads.json, checksum-pinned.
# Keep the installation intact; build packages belong ONLY in the separate venv.
# =============================================================================
ENV PYTHON_BUILD_VENV="/opt/python-build-venv"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN test "$(uname -m)" = x86_64 && \
    mkdir -p /tmp/python-standalone /opt/python && \
    wget -q "https://github.com/astral-sh/python-build-standalone/releases/download/20261001/cpython-3.11.17+20261001-x86_64-unknown-linux-gnu-pgo+lto-full.tar.zst" \
        -O /tmp/python-standalone/python.tar.zst && \
    echo "a98646d6a9b5366be6af3f8cfb1f15abc1f7841472edf326328342ac2dc23b0d  /tmp/python-standalone/python.tar.zst" | sha256sum -c - && \
    tar --zstd -xf /tmp/python-standalone/python.tar.zst -C /tmp/python-standalone && \
    cp -a /tmp/python-standalone/python/install/. /opt/python/ && \
    cp -a /tmp/python-standalone/python/licenses /opt/python/licenses && \
    cp -a /tmp/python-standalone/python/PYTHON.json /opt/python/PYTHON.json && \
    wget -q "https://raw.githubusercontent.com/python/cpython-source-deps/zlib-ng-2.2.4/LICENSE.md" \
        -O /opt/python/licenses/LICENSE.zlib-ng.txt && \
    echo "6c9f0d975b41afaa34d22f55bb8986ce69e5cb7ad327cb2b28820cd425edf5ee  /opt/python/licenses/LICENSE.zlib-ng.txt" | sha256sum -c - && \
    rm -rf /tmp/python-standalone

# Test before creating the build venv; no network or Python/loader overrides.
COPY docker/check-python-relocation.sh /usr/local/bin/check-python-relocation.sh
RUN --network=none bash /usr/local/bin/check-python-relocation.sh /opt/python

# Suppress build-time bytecode writes to the release runtime. This variable is
# NOT required to run the bundled interpreter, as the relocation test proves.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/python-build-venv/bin:${PATH}"

RUN --mount=type=cache,target=/root/.cache/pip \
    /opt/python/bin/python3.11 -m venv "${PYTHON_BUILD_VENV}" && \
    "${PYTHON_BUILD_VENV}/bin/python" -m pip install "numpy==1.26.4" && \
    /opt/python/bin/python3.11 -c 'import importlib.util; assert importlib.util.find_spec("numpy") is None' && \
    "${PYTHON_BUILD_VENV}/bin/python" -c 'import numpy, sys; assert sys.prefix != sys.base_prefix; assert numpy.__version__ == "1.26.4"'

# =============================================================================
# CMake — official binary distribution (avoids a full source build)
# =============================================================================

# Re-declare ARGs after FROM so they are visible in this build stage
ARG CMAKE_VERSION

RUN wget -qO- "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" | tar xz --strip-components=1 -C /usr/local

# Allows --target toolchain validation without fetching/building C++ deps.
FROM toolchain AS deps-base

# =============================================================================
# AliceVision paths
# =============================================================================
ENV AV_DEV="/opt/AliceVision_git"         \
    AV_BUILD="/tmp/AliceVision_build"     \
    AV_INSTALL="/opt/AliceVision_install"

# =============================================================================
# CPU core detection helper
# =============================================================================
COPY docker/check-cpu.sh ${AV_DEV}/docker/check-cpu.sh

# =============================================================================
# CMake sources + dependency build
#
# The build tree and the install prefix live in BuildKit cache mounts, which
# are kept across builds, including failed ones: when a dependency fails, the
# next build resumes from it (ExternalProject skips the steps already done)
# instead of rebuilding everything. Changed recipes in src/cmake are picked up
# as well: ExternalProject reruns the steps whose command changed.
# Archives are downloaded into ${AV_BUILD}/external/download, in the same cache.
#
# Set DEPS_CLEAN=1 (DEPS_NO_CACHE=1 in docker/build-image.sh) to start from
# scratch, e.g. for release images (no leftovers of older versions in the
# install prefix): --no-cache does not clear cache mounts.
# =============================================================================
FROM deps-base AS deps-build

COPY CMakeLists.txt                        ${AV_DEV}/
COPY src/cmake/                            ${AV_DEV}/src/cmake/

WORKDIR "${AV_BUILD}"

ARG DEPS_CLEAN=0
RUN --mount=type=cache,id=alicevision-deps-build-rocky,target=${AV_BUILD},sharing=locked \
    --mount=type=cache,id=alicevision-deps-install-rocky,target=${AV_INSTALL},sharing=locked \
    if [ "${DEPS_CLEAN}" = 1 ]; then \
        find "${AV_INSTALL}" -mindepth 1 -maxdepth 1 -exec rm -rf {} + && \
        find "${AV_BUILD}" -mindepth 1 -maxdepth 1 ! -name external -exec rm -rf {} + && \
        { ! test -d "${AV_BUILD}/external" || \
          find "${AV_BUILD}/external" -mindepth 1 -maxdepth 1 ! -name download -exec rm -rf {} + ; } ; \
    fi && \
    CPU_CORES=$(${AV_DEV}/docker/check-cpu.sh) && \
    cmake "${AV_DEV}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DALICEVISION_BUILD_DEPENDENCIES:BOOL=ON \
        -DAV_BUILD_ALICEVISION:BOOL=OFF \
        -DPython_EXECUTABLE:FILEPATH="${PYTHON_BUILD_VENV}/bin/python" \
        -DPython3_EXECUTABLE:FILEPATH="${PYTHON_BUILD_VENV}/bin/python" \
        -DCMAKE_INSTALL_PREFIX="${AV_INSTALL}" \
        -DAV_BUILD_DEPENDENCIES_PARALLEL=${CPU_CORES} \
    && mkdir -p "${AV_INSTALL}/bin" "${AV_INSTALL}/lib" \
    && ln -sfn lib "${AV_INSTALL}/lib64" \
    && cmake --build . --parallel 1 \
    && /opt/python/bin/python3.11 -c 'import importlib.util; assert importlib.util.find_spec("numpy") is None' \
    && rm -rf /export \
    && cp -a "${AV_INSTALL}" /export \
    && mv /export/bin /export/bin-deps

# =============================================================================
# Final image: only the installed dependencies, never the build tree
# =============================================================================
FROM deps-base AS alicevision-deps

COPY --from=deps-build /export ${AV_INSTALL}
