# syntax=docker/dockerfile:1.4
# vim: ft=dockerfile

# =============================================================================
# Dockerfile_ubuntu_deps
#
# Builds all AliceVision third-party dependencies on Ubuntu + CUDA.
# Requires BuildKit:  DOCKER_BUILDKIT=1 docker build ...
#
# Build example:
#   DOCKER_BUILDKIT=1 docker build \
#     --build-arg CUDA_VERSION=12.8.0 \
#     --build-arg UBUNTU_VERSION=22.04 \
#     --tag alicevision/alicevision-deps:<version>-ubuntu22.04-cuda12.8.0 \
#     -f docker/Dockerfile_ubuntu_deps .
# =============================================================================

ARG CUDA_VERSION
ARG UBUNTU_VERSION
ARG CMAKE_VERSION=3.31.11

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS toolchain
LABEL maintainer="AliceVision Team alicevision-team@googlegroups.com"

# Re-declare ARGs after FROM so they are visible in this build stage
ARG UBUNTU_VERSION
ARG CMAKE_VERSION

# Fail a RUN on any error in a pipe (wget | gpg, curl | python), not only the last command
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# =============================================================================
# System packages + GCC 12 + CMake (Kitware PPA)
#
# Single RUN to minimise layers.
# BuildKit cache mount on /var/cache/apt avoids re-downloading .deb on rebuild;
# docker-clean (shipped by the Ubuntu base image) would delete them after each install.
# =============================================================================
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked  \
    rm -f /etc/apt/apt.conf.d/docker-clean                  && \
    apt-get update                                          && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates                                       \
        gpg                                                   \
        wget                                                  \
        software-properties-common                          && \
    # ── Kitware PPA for a recent CMake ──────────────────────────────────────
    wget -qO - https://apt.kitware.com/keys/kitware-archive-latest.asc \
        | gpg --dearmor \
        | tee /usr/share/keyrings/kitware-archive-keyring.gpg >/dev/null  && \
    echo "deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ $(. /etc/os-release && echo "${VERSION_CODENAME}") main" \
        | tee /etc/apt/sources.list.d/kitware.list >/dev/null              && \
    # ── deadsnakes PPA for Python 3.11 ───────────────────────────────────────
    add-apt-repository ppa:deadsnakes/ppa                               && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        automake                                                          \
        bison                                                             \
        build-essential                                                   \
        cmake=${CMAKE_VERSION}-0kitware1ubuntu${UBUNTU_VERSION}.1         \
        cmake-data=${CMAKE_VERSION}-0kitware1ubuntu${UBUNTU_VERSION}.1    \
        cpp-12                                                            \
        curl                                                              \
        file                                                              \
        g++-12                                                            \
        gcc-12                                                            \
        gfortran-12                                                       \
        git                                                               \
        libpcre2-dev                                                      \
        libssl-dev                                                        \
        libtool                                                           \
        libxerces-c-dev                                                   \
        libyaml-cpp-dev                                                   \
        nasm                                                              \
        pkg-config                                                        \
        python3.11                                                        \
        python3.11-dev                                                    \
        python3.11-distutils                                              \
        texinfo                                                           \
        unzip                                                             \
        yasm                                                              \
        ninja-build                                                       \
    && update-alternatives \
        --install /usr/bin/gcc     gcc     /usr/bin/gcc-12     100        \
        --slave   /usr/bin/g++     g++     /usr/bin/g++-12                \
        --slave   /usr/bin/gcov    gcov    /usr/bin/gcov-12               \
        --slave   /usr/bin/gfortran gfortran /usr/bin/gfortran-12

# =============================================================================
# Python packages + convenience symlink
# pip comes from its versioned zipapp, checksum-pinned (get-pip.py is unversioned).
# numpy is pinned to the same version as in the Rocky image.
# BuildKit cache mount on pip avoids re-downloading wheels on rebuild.
# =============================================================================
RUN --mount=type=cache,target=/root/.cache/pip                                \
    curl -sSfL -o /tmp/pip.pyz https://bootstrap.pypa.io/pip/zipapp/pip-25.2.pyz && \
    echo "769a10214aca718618e7014ec8e70b36288fe9d49a9d7ba3185ea3917e84a4d3  /tmp/pip.pyz" | sha256sum -c - && \
    python3.11 /tmp/pip.pyz install "pip==25.2" "numpy==1.26.4"            && \
    rm /tmp/pip.pyz                                                         && \
    ln -sf /usr/bin/python3.11 /usr/bin/python

# Allows --target toolchain validation without fetching/building C++ deps.
FROM toolchain AS deps-base

# =============================================================================
# AliceVision paths
# =============================================================================
ENV AV_DEV="/opt/AliceVision_git"         \
    AV_BUILD="/tmp/AliceVision_build"     \
    AV_INSTALL="/opt/AliceVision_install"

# =============================================================================
# CPU core detection helper
# =============================================================================
COPY docker/check-cpu.sh ${AV_DEV}/docker/check-cpu.sh

# =============================================================================
# CMake sources + dependency build
#
# The build tree and the install prefix live in BuildKit cache mounts, which
# are kept across builds, including failed ones: when a dependency fails, the
# next build resumes from it (ExternalProject skips the steps already done)
# instead of rebuilding everything. Changed recipes in src/cmake are picked up
# as well: ExternalProject reruns the steps whose command changed.
# Archives are downloaded into ${AV_BUILD}/external/download, in the same cache.
#
# Set DEPS_CLEAN=1 (DEPS_NO_CACHE=1 in docker/build-image.sh) to start from
# scratch, e.g. for release images (no leftovers of older versions in the
# install prefix): --no-cache does not clear cache mounts.
# =============================================================================
FROM deps-base AS deps-build

COPY CMakeLists.txt                        ${AV_DEV}/
COPY src/cmake/                            ${AV_DEV}/src/cmake/

WORKDIR "${AV_BUILD}"

ARG DEPS_CLEAN=0
RUN --mount=type=cache,id=alicevision-deps-build-ubuntu,target=${AV_BUILD},sharing=locked \
    --mount=type=cache,id=alicevision-deps-install-ubuntu,target=${AV_INSTALL},sharing=locked \
    if [ "${DEPS_CLEAN}" = 1 ]; then \
        find "${AV_INSTALL}" -mindepth 1 -maxdepth 1 -exec rm -rf {} + && \
        find "${AV_BUILD}" -mindepth 1 -maxdepth 1 ! -name external -exec rm -rf {} + && \
        { ! test -d "${AV_BUILD}/external" || \
          find "${AV_BUILD}/external" -mindepth 1 -maxdepth 1 ! -name download -exec rm -rf {} + ; } ; \
    fi && \
    CPU_CORES=$(${AV_DEV}/docker/check-cpu.sh) && \
    cmake "${AV_DEV}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DALICEVISION_BUILD_DEPENDENCIES:BOOL=ON \
        -DAV_BUILD_ALICEVISION:BOOL=OFF \
        -DPython3_EXECUTABLE=/usr/bin/python3.11 \
        -DCMAKE_INSTALL_PREFIX="${AV_INSTALL}" \
        -DAV_BUILD_DEPENDENCIES_PARALLEL=${CPU_CORES} \
    && mkdir -p "${AV_INSTALL}/bin" "${AV_INSTALL}/lib" \
    && ln -sfn lib "${AV_INSTALL}/lib64" \
    && cmake --build . --parallel 1 \
    && rm -rf /export \
    && cp -a "${AV_INSTALL}" /export \
    && mv /export/bin /export/bin-deps

# =============================================================================
# Final image: only the installed dependencies, never the build tree
# =============================================================================
FROM deps-base AS alicevision-deps

COPY --from=deps-build /export ${AV_INSTALL}
