{
    "header": {
        "releaseVersion": "2026.1.0+develop",
        "fileVersion": "2.2",
        "template": true
    },
    "nodeDescriptions": {
        "CameraInit": {
            "12.1": {
                "inputs": {
                    "viewpoints": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "GroupAttribute",
                            "name": "viewpoint",
                            "items": {
                                "viewId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "poseId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "path": {
                                    "type": "File",
                                    "value": ""
                                },
                                "intrinsicId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "rigId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "subPoseId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "metadata": {
                                    "type": "StringParam",
                                    "value": ""
                                }
                            }
                        }
                    },
                    "intrinsics": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "GroupAttribute",
                            "name": "intrinsic",
                            "items": {
                                "intrinsicId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "initialFocalLength": {
                                    "type": "FloatParam",
                                    "value": -1.0
                                },
                                "focalLength": {
                                    "type": "FloatParam",
                                    "value": 1000.0
                                },
                                "pixelRatio": {
                                    "type": "FloatParam",
                                    "value": 1.0
                                },
                                "pixelRatioLocked": {
                                    "type": "BoolParam",
                                    "value": true
                                },
                                "scaleLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "offsetLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "distortionLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "type": {
                                    "type": "ChoiceParam",
                                    "value": "pinhole",
                                    "values": [
                                        "pinhole",
                                        "equidistant",
                                        "equirectangular"
                                    ]
                                },
                                "distortionType": {
                                    "type": "ChoiceParam",
                                    "value": "radialk3",
                                    "values": [
                                        "none",
                                        "radialk1",
                                        "radialk3",
                                        "radialk3pt",
                                        "brown",
                                        "fisheye4",
                                        "fisheye1"
                                    ]
                                },
                                "width": {
                                    "type": "IntParam",
                                    "value": 0
                                },
                                "height": {
                                    "type": "IntParam",
                                    "value": 0
                                },
                                "sensorWidth": {
                                    "type": "FloatParam",
                                    "value": 36.0
                                },
                                "sensorHeight": {
                                    "type": "FloatParam",
                                    "value": 24.0
                                },
                                "serialNumber": {
                                    "type": "StringParam",
                                    "value": ""
                                },
                                "principalPoint": {
                                    "type": "GroupAttribute",
                                    "name": "principalPoint",
                                    "items": {
                                        "x": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        },
                                        "y": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        }
                                    }
                                },
                                "initializationMode": {
                                    "type": "ChoiceParam",
                                    "value": "none",
                                    "values": [
                                        "calibrated",
                                        "estimated",
                                        "unknown",
                                        "none"
                                    ]
                                },
                                "distortionInitializationMode": {
                                    "type": "ChoiceParam",
                                    "value": "none",
                                    "values": [
                                        "calibrated",
                                        "estimated",
                                        "unknown",
                                        "none"
                                    ]
                                },
                                "distortionParams": {
                                    "type": "ListAttribute",
                                    "elementDesc": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                },
                                "undistortionOffset": {
                                    "type": "GroupAttribute",
                                    "name": "undistortionOffset",
                                    "items": {
                                        "x": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        },
                                        "y": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        }
                                    }
                                },
                                "undistortionParams": {
                                    "type": "ListAttribute",
                                    "elementDesc": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                },
                                "locked": {
                                    "type": "BoolParam",
                                    "value": false
                                }
                            }
                        }
                    },
                    "sensorDatabase": {
                        "type": "File",
                        "value": "${ALICEVISION_SENSOR_DB}"
                    },
                    "lensCorrectionProfileInfo": {
                        "type": "File",
                        "value": "${ALICEVISION_LENS_PROFILE_INFO}"
                    },
                    "lensCorrectionProfileSearchIgnoreCameraModel": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "defaultFieldOfView": {
                        "type": "FloatParam",
                        "value": 45.0
                    },
                    "groupCameraFallback": {
                        "type": "ChoiceParam",
                        "value": "folder",
                        "values": [
                            "global",
                            "folder",
                            "image"
                        ]
                    },
                    "rawColorInterpretation": {
                        "type": "ChoiceParam",
                        "value": "DCPLinearProcessing",
                        "values": [
                            "None",
                            "LibRawNoWhiteBalancing",
                            "LibRawWhiteBalancing",
                            "DCPLinearProcessing",
                            "DCPMetadata",
                            "Auto"
                        ]
                    },
                    "colorProfileDatabase": {
                        "type": "File",
                        "value": "${ALICEVISION_COLOR_PROFILE_DB}"
                    },
                    "errorOnMissingColorProfile": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "viewIdMethod": {
                        "type": "ChoiceParam",
                        "value": "metadata",
                        "values": [
                            "metadata",
                            "filename"
                        ]
                    },
                    "viewIdRegex": {
                        "type": "StringParam",
                        "value": ".*?(\\d+)"
                    },
                    "isSequence": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/cameraInit.sfm"
                    }
                }
            }
        },
        "CopyFiles": {
            "1.3": {
                "inputs": {
                    "inputFiles": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "output": {
                        "type": "File",
                        "value": ""
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {}
            }
        },
        "FeatureExtraction": {
            "1.3": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "masksFolder": {
                        "type": "File",
                        "value": ""
                    },
                    "maskExtension": {
                        "type": "ChoiceParam",
                        "value": "png",
                        "values": [
                            "png",
                            "exr",
                            "jpg"
                        ]
                    },
                    "maskInvert": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "describerTypes": {
                        "type": "ChoiceParam",
                        "value": [
                            "dspsift"
                        ],
                        "values": [
                            "sift",
                            "sift_float",
                            "sift_upright",
                            "dspsift",
                            "akaze",
                            "akaze_liop",
                            "akaze_mldb",
                            "cctag3",
                            "cctag4",
                            "sift_ocv",
                            "akaze_ocv",
                            "tag16h5",
                            "survey",
                            "roma",
                            "unknown"
                        ],
                        "exclusive": false
                    },
                    "describerPreset": {
                        "type": "ChoiceParam",
                        "value": "normal",
                        "values": [
                            "low",
                            "medium",
                            "normal",
                            "high",
                            "ultra",
                            "custom"
                        ]
                    },
                    "maxNbFeatures": {
                        "type": "IntParam",
                        "value": 0
                    },
                    "describerQuality": {
                        "type": "ChoiceParam",
                        "value": "normal",
                        "values": [
                            "low",
                            "medium",
                            "normal",
                            "high",
                            "ultra"
                        ]
                    },
                    "contrastFiltering": {
                        "type": "ChoiceParam",
                        "value": "GridSort",
                        "values": [
                            "Static",
                            "AdaptiveToMedianVariance",
                            "NoFiltering",
                            "GridSortOctaves",
                            "GridSort",
                            "GridSortScaleSteps",
                            "GridSortOctaveSteps",
                            "NonExtremaFiltering"
                        ]
                    },
                    "relativePeakThreshold": {
                        "type": "FloatParam",
                        "value": 0.01
                    },
                    "gridFiltering": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "workingColorSpace": {
                        "type": "ChoiceParam",
                        "value": "sRGB",
                        "values": [
                            "AUTO",
                            "sRGB",
                            "rec709",
                            "Linear",
                            "ACES2065-1",
                            "ACEScg",
                            "Linear ARRI Wide Gamut 3",
                            "ARRI LogC3 (EI800)",
                            "Linear ARRI Wide Gamut 4",
                            "ARRI LogC4",
                            "Linear BMD WideGamut Gen5",
                            "BMDFilm WideGamut Gen5",
                            "CanonLog2 CinemaGamut D55",
                            "CanonLog3 CinemaGamut D55",
                            "Linear CinemaGamut D55",
                            "Linear V-Gamut",
                            "V-Log V-Gamut",
                            "Linear REDWideGamutRGB",
                            "Log3G10 REDWideGamutRGB",
                            "Linear Venice S-Gamut3.Cine",
                            "S-Log3 Venice S-Gamut3.Cine",
                            "no_conversion"
                        ]
                    },
                    "forceCpuExtraction": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "maxThreads": {
                        "type": "IntParam",
                        "value": 0
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    }
                }
            }
        },
        "FeatureMatching": {
            "2.1": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "featuresFolders": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "imagePairsList": {
                        "type": "File",
                        "value": ""
                    },
                    "describerTypes": {
                        "type": "ChoiceParam",
                        "value": [
                            "dspsift"
                        ],
                        "values": [
                            "sift",
                            "sift_float",
                            "sift_upright",
                            "dspsift",
                            "akaze",
                            "akaze_liop",
                            "akaze_mldb",
                            "cctag3",
                            "cctag4",
                            "sift_ocv",
                            "akaze_ocv",
                            "tag16h5",
                            "survey",
                            "roma",
                            "unknown"
                        ],
                        "exclusive": false
                    },
                    "photometricMatchingMethod": {
                        "type": "ChoiceParam",
                        "value": "ANN_L2",
                        "values": [
                            "BRUTE_FORCE_L2",
                            "ANN_L2",
                            "CASCADE_HASHING_L2",
                            "FAST_CASCADE_HASHING_L2",
                            "BRUTE_FORCE_HAMMING"
                        ]
                    },
                    "geometricEstimator": {
                        "type": "ChoiceParam",
                        "value": "acransac",
                        "values": [
                            "acransac",
                            "loransac"
                        ]
                    },
                    "geometricFilterType": {
                        "type": "ChoiceParam",
                        "value": "fundamental_matrix",
                        "values": [
                            "fundamental_matrix",
                            "fundamental_with_distortion",
                            "essential_matrix",
                            "homography_matrix",
                            "homography_growing",
                            "no_filtering"
                        ]
                    },
                    "distanceRatio": {
                        "type": "FloatParam",
                        "value": 0.8
                    },
                    "maxIteration": {
                        "type": "IntParam",
                        "value": 50000
                    },
                    "geometricError": {
                        "type": "FloatParam",
                        "value": 0.0
                    },
                    "knownPosesGeometricErrorMax": {
                        "type": "FloatParam",
                        "value": 5.0
                    },
                    "minRequired2DMotion": {
                        "type": "FloatParam",
                        "value": -1.0
                    },
                    "maxMatches": {
                        "type": "IntParam",
                        "value": 0
                    },
                    "savePutativeMatches": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "crossMatching": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "guidedMatching": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "matchFromKnownCameraPoses": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "exportDebugFiles": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    }
                }
            }
        },
        "ImageMatching": {
            "2.1": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "featuresFolders": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "method": {
                        "type": "ChoiceParam",
                        "value": "SequentialAndVocabularyTree",
                        "values": [
                            "VocabularyTree",
                            "Sequential",
                            "SequentialAndVocabularyTree",
                            "Exhaustive",
                            "Frustum",
                            "FrustumOrVocabularyTree",
                            "Mirror"
                        ]
                    },
                    "tree": {
                        "type": "File",
                        "value": "${ALICEVISION_VOCTREE}"
                    },
                    "weights": {
                        "type": "File",
                        "value": ""
                    },
                    "minNbImages": {
                        "type": "IntParam",
                        "value": 200
                    },
                    "maxDescriptors": {
                        "type": "IntParam",
                        "value": 500
                    },
                    "nbMatches": {
                        "type": "IntParam",
                        "value": 40
                    },
                    "nbNeighbors": {
                        "type": "IntParam",
                        "value": 5
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/imageMatches.txt"
                    }
                }
            }
        },
        "MeshFiltering": {
            "3.0": {
                "inputs": {
                    "inputMesh": {
                        "type": "File",
                        "value": ""
                    },
                    "outputMeshFileType": {
                        "type": "ChoiceParam",
                        "value": "obj",
                        "values": [
                            "gltf",
                            "obj",
                            "fbx",
                            "stl"
                        ]
                    },
                    "keepLargestMeshOnly": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "smoothingSubset": {
                        "type": "ChoiceParam",
                        "value": "all",
                        "values": [
                            "all",
                            "surface_boundaries",
                            "surface_inner_part"
                        ]
                    },
                    "smoothingBoundariesNeighbours": {
                        "type": "IntParam",
                        "value": 0
                    },
                    "smoothingIterations": {
                        "type": "IntParam",
                        "value": 5
                    },
                    "smoothingLambda": {
                        "type": "FloatParam",
                        "value": 1.0
                    },
                    "filteringSubset": {
                        "type": "ChoiceParam",
                        "value": "all",
                        "values": [
                            "all",
                            "surface_boundaries",
                            "surface_inner_part"
                        ]
                    },
                    "filteringIterations": {
                        "type": "IntParam",
                        "value": 1
                    },
                    "filterLargeTrianglesFactor": {
                        "type": "FloatParam",
                        "value": 60.0
                    },
                    "filterTrianglesRatio": {
                        "type": "FloatParam",
                        "value": 0.0
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "outputMesh": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/mesh.{outputMeshFileTypeValue}"
                    }
                }
            }
        },
        "Meshing": {
            "7.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "depthMapsFolder": {
                        "type": "File",
                        "value": ""
                    },
                    "outputMeshFileType": {
                        "type": "ChoiceParam",
                        "value": "obj",
                        "values": [
                            "gltf",
                            "obj",
                            "fbx",
                            "stl"
                        ]
                    },
                    "useBoundingBox": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "boundingBox": {
                        "type": "GroupAttribute",
                        "name": "boundingBox",
                        "items": {
                            "bboxTranslation": {
                                "type": "GroupAttribute",
                                "name": "bboxTranslation",
                                "items": {
                                    "x": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    },
                                    "y": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    },
                                    "z": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                }
                            },
                            "bboxRotation": {
                                "type": "GroupAttribute",
                                "name": "bboxRotation",
                                "items": {
                                    "x": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    },
                                    "y": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    },
                                    "z": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                }
                            },
                            "bboxScale": {
                                "type": "GroupAttribute",
                                "name": "bboxScale",
                                "items": {
                                    "x": {
                                        "type": "FloatParam",
                                        "value": 1.0
                                    },
                                    "y": {
                                        "type": "FloatParam",
                                        "value": 1.0
                                    },
                                    "z": {
                                        "type": "FloatParam",
                                        "value": 1.0
                                    }
                                }
                            }
                        }
                    },
                    "estimateSpaceFromSfM": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "estimateSpaceMinObservations": {
                        "type": "IntParam",
                        "value": 3
                    },
                    "estimateSpaceMinObservationAngle": {
                        "type": "FloatParam",
                        "value": 10.0
                    },
                    "maxInputPoints": {
                        "type": "IntParam",
                        "value": 50000000
                    },
                    "maxPoints": {
                        "type": "IntParam",
                        "value": 5000000
                    },
                    "maxPointsPerVoxel": {
                        "type": "IntParam",
                        "value": 1000000
                    },
                    "minStep": {
                        "type": "IntParam",
                        "value": 2
                    },
                    "partitioning": {
                        "type": "ChoiceParam",
                        "value": "singleBlock",
                        "values": [
                            "singleBlock",
                            "auto"
                        ]
                    },
                    "repartition": {
                        "type": "ChoiceParam",
                        "value": "multiResolution",
                        "values": [
                            "multiResolution",
                            "regularGrid"
                        ]
                    },
                    "angleFactor": {
                        "type": "FloatParam",
                        "value": 15.0
                    },
                    "simFactor": {
                        "type": "FloatParam",
                        "value": 15.0
                    },
                    "minVis": {
                        "type": "IntParam",
                        "value": 2
                    },
                    "pixSizeMarginInitCoef": {
                        "type": "FloatParam",
                        "value": 2.0
                    },
                    "pixSizeMarginFinalCoef": {
                        "type": "FloatParam",
                        "value": 4.0
                    },
                    "voteMarginFactor": {
                        "type": "FloatParam",
                        "value": 4.0
                    },
                    "contributeMarginFactor": {
                        "type": "FloatParam",
                        "value": 2.0
                    },
                    "simGaussianSizeInit": {
                        "type": "FloatParam",
                        "value": 10.0
                    },
                    "simGaussianSize": {
                        "type": "FloatParam",
                        "value": 10.0
                    },
                    "minAngleThreshold": {
                        "type": "FloatParam",
                        "value": 1.0
                    },
                    "refineFuse": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "helperPointsGridSize": {
                        "type": "IntParam",
                        "value": 10
                    },
                    "densify": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "densifyNbFront": {
                        "type": "IntParam",
                        "value": 1
                    },
                    "densifyNbBack": {
                        "type": "IntParam",
                        "value": 1
                    },
                    "densifyScale": {
                        "type": "FloatParam",
                        "value": 20.0
                    },
                    "nPixelSizeBehind": {
                        "type": "FloatParam",
                        "value": 4.0
                    },
                    "fullWeight": {
                        "type": "FloatParam",
                        "value": 1.0
                    },
                    "voteFilteringForWeaklySupportedSurfaces": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "addLandmarksToTheDensePointCloud": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "invertTetrahedronBasedOnNeighborsNbIterations": {
                        "type": "IntParam",
                        "value": 10
                    },
                    "minSolidAngleRatio": {
                        "type": "FloatParam",
                        "value": 0.2
                    },
                    "nbSolidAngleFilteringIterations": {
                        "type": "IntParam",
                        "value": 2
                    },
                    "colorizeOutput": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "addMaskHelperPoints": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "maskHelperPointsWeight": {
                        "type": "FloatParam",
                        "value": 1.0
                    },
                    "maskBorderSize": {
                        "type": "IntParam",
                        "value": 4
                    },
                    "maxNbConnectedHelperPoints": {
                        "type": "IntParam",
                        "value": 50
                    },
                    "saveRawDensePointCloud": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "exportDebugTetrahedralization": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "seed": {
                        "type": "IntParam",
                        "value": 0
                    },
                    "verboseLevel": {
