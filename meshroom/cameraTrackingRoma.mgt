                    },
                    "outputTracks": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/tracksFile.json"
                    }
                }
            }
        },
        "KeyframeSelection": {
            "5.0": {
                "inputs": {
                    "inputPaths": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "brands": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "models": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "mmFocals": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "FloatParam",
                            "value": 0.0
                        }
                    },
                    "sensorDbPath": {
                        "type": "File",
                        "value": "${ALICEVISION_SENSOR_DB}"
                    },
                    "maskPaths": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "selectionMethod": {
                        "type": "GroupAttribute",
                        "name": "selectionMethod",
                        "items": {
                            "useSmartSelection": {
                                "type": "BoolParam",
                                "value": true
                            },
                            "regularSelection": {
                                "type": "GroupAttribute",
                                "name": "regularSelection",
                                "items": {
                                    "minFrameStep": {
                                        "type": "IntParam",
                                        "value": 12
                                    },
                                    "maxFrameStep": {
                                        "type": "IntParam",
                                        "value": 0
                                    },
                                    "maxNbOutFrames": {
                                        "type": "IntParam",
                                        "value": 0
                                    }
                                }
                            },
                            "smartSelection": {
                                "type": "GroupAttribute",
                                "name": "smartSelection",
