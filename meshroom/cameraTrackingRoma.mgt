{
    "header": {
        "releaseVersion": "2026.1.0+develop",
        "fileVersion": "2.2",
        "template": true
    },
    "nodeDescriptions": {
        "ApplyCalibration": {
            "1.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "calibration": {
                        "type": "File",
                        "value": ""
                    },
                    "useJson": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/sfmData.sfm"
                    }
                }
            }
        },
        "CameraInit": {
            "12.1": {
                "inputs": {
                    "viewpoints": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "GroupAttribute",
                            "name": "viewpoint",
                            "items": {
                                "viewId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "poseId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "path": {
                                    "type": "File",
                                    "value": ""
                                },
                                "intrinsicId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "rigId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "subPoseId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "metadata": {
                                    "type": "StringParam",
                                    "value": ""
                                }
                            }
                        }
                    },
                    "intrinsics": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "GroupAttribute",
                            "name": "intrinsic",
                            "items": {
                                "intrinsicId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "initialFocalLength": {
                                    "type": "FloatParam",
                                    "value": -1.0
                                },
                                "focalLength": {
                                    "type": "FloatParam",
                                    "value": 1000.0
                                },
                                "pixelRatio": {
                                    "type": "FloatParam",
                                    "value": 1.0
                                },
                                "pixelRatioLocked": {
                                    "type": "BoolParam",
                                    "value": true
                                },
                                "scaleLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "offsetLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "distortionLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "type": {
                                    "type": "ChoiceParam",
                                    "value": "pinhole",
                                    "values": [
                                        "pinhole",
                                        "equidistant",
                                        "equirectangular"
                                    ]
                                },
                                "distortionType": {
                                    "type": "ChoiceParam",
                                    "value": "radialk3",
                                    "values": [
                                        "none",
                                        "radialk1",
                                        "radialk3",
                                        "radialk3pt",
                                        "brown",
                                        "fisheye4",
                                        "fisheye1"
                                    ]
                                },
                                "width": {
                                    "type": "IntParam",
                                    "value": 0
                                },
                                "height": {
                                    "type": "IntParam",
                                    "value": 0
                                },
                                "sensorWidth": {
                                    "type": "FloatParam",
                                    "value": 36.0
                                },
                                "sensorHeight": {
                                    "type": "FloatParam",
                                    "value": 24.0
                                },
                                "serialNumber": {
                                    "type": "StringParam",
                                    "value": ""
                                },
                                "principalPoint": {
                                    "type": "GroupAttribute",
                                    "name": "principalPoint",
                                    "items": {
                                        "x": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        },
                                        "y": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        }
                                    }
                                },
                                "initializationMode": {
                                    "type": "ChoiceParam",
                                    "value": "none",
                                    "values": [
                                        "calibrated",
                                        "estimated",
                                        "unknown",
                                        "none"
                                    ]
                                },
                                "distortionInitializationMode": {
                                    "type": "ChoiceParam",
                                    "value": "none",
                                    "values": [
                                        "calibrated",
                                        "estimated",
                                        "unknown",
                                        "none"
                                    ]
                                },
                                "distortionParams": {
                                    "type": "ListAttribute",
                                    "elementDesc": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                },
                                "undistortionOffset": {
                                    "type": "GroupAttribute",
                                    "name": "undistortionOffset",
                                    "items": {
                                        "x": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        },
                                        "y": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        }
                                    }
                                },
                                "undistortionParams": {
                                    "type": "ListAttribute",
                                    "elementDesc": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                },
                                "locked": {
                                    "type": "BoolParam",
                                    "value": false
                                }
                            }
                        }
                    },
                    "sensorDatabase": {
                        "type": "File",
                        "value": "${ALICEVISION_SENSOR_DB}"
                    },
                    "lensCorrectionProfileInfo": {
                        "type": "File",
                        "value": "${ALICEVISION_LENS_PROFILE_INFO}"
                    },
                    "lensCorrectionProfileSearchIgnoreCameraModel": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "defaultFieldOfView": {
                        "type": "FloatParam",
                        "value": 45.0
                    },
                    "groupCameraFallback": {
                        "type": "ChoiceParam",
                        "value": "folder",
                        "values": [
                            "global",
                            "folder",
                            "image"
                        ]
                    },
                    "rawColorInterpretation": {
                        "type": "ChoiceParam",
                        "value": "DCPLinearProcessing",
                        "values": [
                            "None",
                            "LibRawNoWhiteBalancing",
                            "LibRawWhiteBalancing",
                            "DCPLinearProcessing",
                            "DCPMetadata",
                            "Auto"
                        ]
                    },
                    "colorProfileDatabase": {
                        "type": "File",
                        "value": "${ALICEVISION_COLOR_PROFILE_DB}"
                    },
                    "errorOnMissingColorProfile": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "viewIdMethod": {
                        "type": "ChoiceParam",
                        "value": "metadata",
                        "values": [
                            "metadata",
                            "filename"
                        ]
                    },
                    "viewIdRegex": {
                        "type": "StringParam",
                        "value": ".*?(\\d+)"
                    },
                    "isSequence": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/cameraInit.sfm"
                    }
                }
            }
        },
        "CheckerboardDetection": {
            "2.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "useNestedGrids": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "doubleSize": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "ignorePixelAspectRatio": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "useAllSeeds": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "maxLevels": {
                        "type": "IntParam",
                        "value": 2
                    },
                    "minConsensus": {
                        "type": "IntParam",
                        "value": 5
                    },
                    "exportDebugImages": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    },
                    "checkerLines": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<VIEW_ID>.png"
                    }
                }
            }
        },
        "ConvertSfMFormat": {
            "2.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "fileExt": {
                        "type": "ChoiceParam",
                        "value": "usda",
                        "values": [
                            "abc",
                            "usda",
                            "sfm",
                            "json",
                            "ply",
                            "baf"
                        ]
                    },
                    "describerTypes": {
                        "type": "ChoiceParam",
                        "value": [
                            "dspsift"
                        ],
                        "values": [
                            "sift",
                            "sift_float",
                            "sift_upright",
                            "dspsift",
                            "akaze",
                            "akaze_liop",
                            "akaze_mldb",
                            "cctag3",
                            "cctag4",
                            "sift_ocv",
                            "akaze_ocv",
                            "tag16h5",
                            "survey",
                            "roma",
                            "unknown"
                        ],
                        "exclusive": false
                    },
                    "imageWhiteList": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "views": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "intrinsics": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "extrinsics": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "structure": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "observations": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "surveys": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/sfm.{fileExtValue}"
                    }
                }
            }
        },
        "CopyFiles": {
            "1.3": {
                "inputs": {
                    "inputFiles": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "output": {
                        "type": "File",
                        "value": ""
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {}
            }
        },
        "DistortionCalibration": {
            "6.1": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "checkerboards": {
                        "type": "File",
                        "value": ""
                    },
                    "undistortionModelName": {
                        "type": "ChoiceParam",
                        "value": "3deanamorphic4",
                        "values": [
                            "3deanamorphic4",
                            "3declassicld",
                            "3deradial4"
                        ]
                    },
                    "bestOnly": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "handleSqueeze": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "isDesqueezed": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "forcedPixelAspectRatio": {
                        "type": "FloatParam",
                        "value": 0.0
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/sfmData.sfm"
                    }
                }
            }
        },
        "ExportAlembic": {
            "1.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "frameRate": {
                        "type": "FloatParam",
                        "value": 24.0
                    },
                    "exportLandmarks": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/animated.abc"
                    }
                }
            }
        },
        "ExportDistortion": {
            "2.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "exportNukeNode": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "exportAnimatedNukeNode": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "exportLensGridsUndistorted": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "exportSTMaps": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    },
                    "distortionNukeNode": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/nukeLensDistortion_<INTRINSIC_ID>.nk"
                    },
                    "lensGridsUndistorted": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/lensgrid_<VIEW_ID>_undistort.exr"
                    },
                    "distortionStMap": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/stmap_<INTRINSIC_ID>_distort.exr"
                    },
                    "undistortionStMap": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/stmap_<INTRINSIC_ID>_undistort.exr"
                    }
                }
            }
        },
        "ExportImages": {
            "1.1": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "target": {
                        "type": "File",
                        "value": ""
                    },
                    "masksFolders": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "outputFileType": {
                        "type": "ChoiceParam",
                        "value": "exr",
                        "values": [
                            "jpg",
                            "png",
                            "tif",
                            "exr"
                        ]
                    },
                    "evCorrection": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "exportFullROD": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "namingMode": {
                        "type": "ChoiceParam",
                        "value": "viewid",
                        "values": [
                            "viewid",
                            "frameid",
                            "keep"
                        ]
                    },
                    "maskExtension": {
                        "type": "ChoiceParam",
                        "value": "png",
                        "values": [
                            "exr",
                            "jpg",
                            "png"
                        ]
                    },
                    "storageDataType": {
                        "type": "ChoiceParam",
                        "value": "halfFinite",
                        "values": [
                            "float",
                            "half",
                            "halfFinite",
                            "auto"
                        ]
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    },
                    "undistorted": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<FILESTEM>.{outputFileTypeValue}"
                    },
                    "outputSfMData": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/sfm.usda"
                    }
                }
            }
        },
        "GeometricFilterEstimating": {
            "1.1": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "featuresFolders": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "matchesFolders": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "describerTypes": {
                        "type": "ChoiceParam",
                        "value": [
                            "dspsift"
                        ],
                        "values": [
                            "sift",
                            "sift_float",
                            "sift_upright",
                            "dspsift",
                            "akaze",
                            "akaze_liop",
                            "akaze_mldb",
                            "cctag3",
                            "cctag4",
                            "sift_ocv",
                            "akaze_ocv",
                            "tag16h5",
                            "survey",
                            "roma",
                            "unknown"
                        ],
                        "exclusive": false
                    },
                    "maxIteration": {
                        "type": "IntParam",
                        "value": 50000
                    },
                    "geometricError": {
                        "type": "FloatParam",
                        "value": 0.0
                    },
                    "minMatches": {
                        "type": "IntParam",
                        "value": 0
                    },
                    "maxMatches": {
                        "type": "IntParam",
                        "value": 0
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    }
                }
            }
        },
        "ImageSegmentationSam3": {
            "2.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "prompt": {
                        "type": "StringParam",
                        "value": "person\nchild\npeople"
                    },
                    "bboxFolder": {
                        "type": "File",
                        "value": ""
                    },
                    "segmentationModelPath": {
                        "type": "File",
                        "value": "${RDS_SAM3_MODEL_PATH}"
                    },
                    "enableBonding": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "bondingKernelSize": {
                        "type": "IntParam",
                        "value": 11
                    },
                    "maskInvert": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "useGpu": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "keepFilename": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "extensionOut": {
                        "type": "ChoiceParam",
                        "value": "exr",
                        "values": [
                            "exr",
                            "png",
                            "jpg"
                        ]
                    },
                    "splitBoxPrompt": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "positiveBoxes": {
                        "type": "ShapeList",
                        "shape": {
                            "type": "Rectangle",
                            "name": "bbox"
                        }
                    },
                    "negativeBoxes": {
                        "type": "ShapeList",
                        "shape": {
                            "type": "Rectangle",
                            "name": "bbox"
                        }
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    },
                    "masks": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<FILESTEM>.exr"
                    }
                }
            }
        },
        "IntrinsicsTransforming": {
            "1.1": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "inputTracks": {
                        "type": "File",
                        "value": ""
                    },
                    "type": {
                        "type": "ChoiceParam",
                        "value": "pinhole",
                        "values": [
                            "pinhole",
                            "equidistant",
                            "equirectangular"
                        ]
                    },
                    "fakeFov": {
                        "type": "FloatParam",
                        "value": 90.0
                    },
                    "scaleFactor": {
                        "type": "FloatParam",
                        "value": 1.0
                    },
                    "correctPrincipalPoint": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
