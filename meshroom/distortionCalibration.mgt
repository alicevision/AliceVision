{
    "header": {
        "releaseVersion": "2026.1.0+develop",
        "fileVersion": "2.2",
        "template": true
    },
    "nodeDescriptions": {
        "CameraInit": {
            "12.1": {
                "inputs": {
                    "viewpoints": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "GroupAttribute",
                            "name": "viewpoint",
                            "items": {
                                "viewId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "poseId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "path": {
                                    "type": "File",
                                    "value": ""
                                },
                                "intrinsicId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "rigId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "subPoseId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "metadata": {
                                    "type": "StringParam",
                                    "value": ""
                                }
                            }
                        }
                    },
                    "intrinsics": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "GroupAttribute",
                            "name": "intrinsic",
                            "items": {
                                "intrinsicId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "initialFocalLength": {
                                    "type": "FloatParam",
                                    "value": -1.0
                                },
                                "focalLength": {
                                    "type": "FloatParam",
                                    "value": 1000.0
                                },
                                "pixelRatio": {
                                    "type": "FloatParam",
                                    "value": 1.0
                                },
                                "pixelRatioLocked": {
                                    "type": "BoolParam",
                                    "value": true
                                },
                                "scaleLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "offsetLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "distortionLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "type": {
                                    "type": "ChoiceParam",
                                    "value": "pinhole",
                                    "values": [
                                        "pinhole",
                                        "equidistant",
                                        "equirectangular"
                                    ]
                                },
                                "distortionType": {
                                    "type": "ChoiceParam",
                                    "value": "radialk3",
                                    "values": [
                                        "none",
                                        "radialk1",
                                        "radialk3",
                                        "radialk3pt",
                                        "brown",
                                        "fisheye4",
                                        "fisheye1"
                                    ]
                                },
                                "width": {
                                    "type": "IntParam",
                                    "value": 0
                                },
                                "height": {
                                    "type": "IntParam",
                                    "value": 0
                                },
                                "sensorWidth": {
                                    "type": "FloatParam",
                                    "value": 36.0
                                },
                                "sensorHeight": {
                                    "type": "FloatParam",
                                    "value": 24.0
                                },
                                "serialNumber": {
                                    "type": "StringParam",
                                    "value": ""
                                },
                                "principalPoint": {
                                    "type": "GroupAttribute",
                                    "name": "principalPoint",
                                    "items": {
                                        "x": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        },
                                        "y": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        }
                                    }
                                },
                                "initializationMode": {
                                    "type": "ChoiceParam",
                                    "value": "none",
                                    "values": [
                                        "calibrated",
                                        "estimated",
                                        "unknown",
                                        "none"
                                    ]
                                },
                                "distortionInitializationMode": {
                                    "type": "ChoiceParam",
                                    "value": "none",
                                    "values": [
                                        "calibrated",
                                        "estimated",
                                        "unknown",
                                        "none"
                                    ]
                                },
                                "distortionParams": {
                                    "type": "ListAttribute",
                                    "elementDesc": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                },
                                "undistortionOffset": {
                                    "type": "GroupAttribute",
                                    "name": "undistortionOffset",
                                    "items": {
                                        "x": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        },
                                        "y": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        }
                                    }
                                },
                                "undistortionParams": {
                                    "type": "ListAttribute",
                                    "elementDesc": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                },
                                "locked": {
                                    "type": "BoolParam",
                                    "value": false
                                }
                            }
                        }
                    },
                    "sensorDatabase": {
                        "type": "File",
                        "value": "${ALICEVISION_SENSOR_DB}"
                    },
                    "lensCorrectionProfileInfo": {
                        "type": "File",
                        "value": "${ALICEVISION_LENS_PROFILE_INFO}"
                    },
                    "lensCorrectionProfileSearchIgnoreCameraModel": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "defaultFieldOfView": {
                        "type": "FloatParam",
                        "value": 45.0
                    },
                    "groupCameraFallback": {
                        "type": "ChoiceParam",
                        "value": "folder",
                        "values": [
                            "global",
                            "folder",
                            "image"
                        ]
                    },
                    "rawColorInterpretation": {
                        "type": "ChoiceParam",
                        "value": "DCPLinearProcessing",
                        "values": [
                            "None",
                            "LibRawNoWhiteBalancing",
                            "LibRawWhiteBalancing",
                            "DCPLinearProcessing",
                            "DCPMetadata",
                            "Auto"
                        ]
                    },
                    "colorProfileDatabase": {
                        "type": "File",
                        "value": "${ALICEVISION_COLOR_PROFILE_DB}"
                    },
                    "errorOnMissingColorProfile": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "viewIdMethod": {
                        "type": "ChoiceParam",
                        "value": "metadata",
                        "values": [
                            "metadata",
                            "filename"
                        ]
                    },
                    "viewIdRegex": {
                        "type": "StringParam",
                        "value": ".*?(\\d+)"
                    },
                    "isSequence": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/cameraInit.sfm"
                    }
                }
            }
        },
        "CheckerboardDetection": {
            "2.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "useNestedGrids": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "doubleSize": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "ignorePixelAspectRatio": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "useAllSeeds": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "maxLevels": {
                        "type": "IntParam",
                        "value": 2
                    },
                    "minConsensus": {
                        "type": "IntParam",
                        "value": 5
                    },
                    "exportDebugImages": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    },
                    "checkerLines": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<VIEW_ID>.png"
                    }
                }
            }
        },
        "CopyFiles": {
            "1.3": {
                "inputs": {
                    "inputFiles": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "output": {
                        "type": "File",
                        "value": ""
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {}
            }
        },
        "DistortionCalibration": {
            "6.1": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "checkerboards": {
                        "type": "File",
                        "value": ""
                    },
                    "undistortionModelName": {
                        "type": "ChoiceParam",
                        "value": "3deanamorphic4",
                        "values": [
                            "3deanamorphic4",
                            "3declassicld",
                            "3deradial4"
                        ]
                    },
                    "bestOnly": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "handleSqueeze": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "isDesqueezed": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "forcedPixelAspectRatio": {
                        "type": "FloatParam",
                        "value": 0.0
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/sfmData.sfm"
                    }
                }
            }
        },
        "ExportDistortion": {
            "2.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "exportNukeNode": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "exportAnimatedNukeNode": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "exportLensGridsUndistorted": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "exportSTMaps": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    },
                    "distortionNukeNode": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/nukeLensDistortion_<INTRINSIC_ID>.nk"
                    },
                    "lensGridsUndistorted": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/lensgrid_<VIEW_ID>_undistort.exr"
                    },
                    "distortionStMap": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/stmap_<INTRINSIC_ID>_distort.exr"
                    },
                    "undistortionStMap": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/stmap_<INTRINSIC_ID>_undistort.exr"
                    }
                }
            }
        }
    },
    "graph": {
        "CameraInit_1": {
            "nodeType": "CameraInit",
            "version": "12.1",
            "position": [
                0,
                0
            ],
            "inputs": {}
        },
        "CheckerboardDetection_1": {
            "nodeType": "CheckerboardDetection",
            "version": "2.0",
            "position": [
                200,
                0
            ],
            "inputs": {
                "input": "{CameraInit_1.output}",
                "useNestedGrids": true,
                "exportDebugImages": true
            }
        },
        "CopyFiles_1": {
            "nodeType": "CopyFiles",
            "version": "1.3",
            "position": [
                800,
                0
            ],
            "inputs": {
                "inputFiles": [
                    "{ExportDistortion_1.output}"
                ]
            }
        },
        "DistortionCalibration_1": {
            "nodeType": "DistortionCalibration",
            "version": "6.1",
            "position": [
                400,
                0
            ],
            "inputs": {
                "input": "{CheckerboardDetection_1.input}",
                "checkerboards": "{CheckerboardDetection_1.output}"
            }
        },
        "ExportDistortion_1": {
            "nodeType": "ExportDistortion",
            "version": "2.0",
            "position": [
                600,
                0
            ],
            "inputs": {
                "input": "{DistortionCalibration_1.output}"
            }
        }
    }
}