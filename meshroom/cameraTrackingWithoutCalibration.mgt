{
    "header": {
        "releaseVersion": "2026.1.0+develop",
        "fileVersion": "2.2",
        "template": true
    },
    "nodeDescriptions": {
        "ApplyCalibration": {
            "1.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "calibration": {
                        "type": "File",
                        "value": ""
                    },
                    "useJson": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/sfmData.sfm"
                    }
                }
            }
        },
        "CameraInit": {
            "12.1": {
                "inputs": {
                    "viewpoints": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "GroupAttribute",
                            "name": "viewpoint",
                            "items": {
                                "viewId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "poseId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "path": {
                                    "type": "File",
                                    "value": ""
                                },
                                "intrinsicId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "rigId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "subPoseId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "metadata": {
                                    "type": "StringParam",
                                    "value": ""
                                }
                            }
                        }
                    },
                    "intrinsics": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "GroupAttribute",
                            "name": "intrinsic",
                            "items": {
                                "intrinsicId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "initialFocalLength": {
                                    "type": "FloatParam",
                                    "value": -1.0
                                },
                                "focalLength": {
                                    "type": "FloatParam",
                                    "value": 1000.0
                                },
                                "pixelRatio": {
                                    "type": "FloatParam",
                                    "value": 1.0
                                },
                                "pixelRatioLocked": {
                                    "type": "BoolParam",
                                    "value": true
                                },
                                "scaleLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "offsetLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "distortionLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "type": {
                                    "type": "ChoiceParam",
                                    "value": "pinhole",
                                    "values": [
                                        "pinhole",
                                        "equidistant",
                                        "equirectangular"
                                    ]
                                },
                                "distortionType": {
                                    "type": "ChoiceParam",
                                    "value": "radialk3",
                                    "values": [
                                        "none",
                                        "radialk1",
                                        "radialk3",
                                        "radialk3pt",
                                        "brown",
                                        "fisheye4",
                                        "fisheye1"
                                    ]
                                },
                                "width": {
                                    "type": "IntParam",
                                    "value": 0
                                },
                                "height": {
                                    "type": "IntParam",
                                    "value": 0
                                },
                                "sensorWidth": {
                                    "type": "FloatParam",
                                    "value": 36.0
                                },
                                "sensorHeight": {
                                    "type": "FloatParam",
                                    "value": 24.0
                                },
                                "serialNumber": {
                                    "type": "StringParam",
                                    "value": ""
                                },
                                "principalPoint": {
                                    "type": "GroupAttribute",
                                    "name": "principalPoint",
                                    "items": {
                                        "x": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        },
                                        "y": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        }
                                    }
                                },
                                "initializationMode": {
                                    "type": "ChoiceParam",
                                    "value": "none",
                                    "values": [
                                        "calibrated",
                                        "estimated",
                                        "unknown",
                                        "none"
                                    ]
                                },
                                "distortionInitializationMode": {
                                    "type": "ChoiceParam",
                                    "value": "none",
                                    "values": [
                                        "calibrated",
                                        "estimated",
                                        "unknown",
                                        "none"
                                    ]
                                },
                                "distortionParams": {
                                    "type": "ListAttribute",
                                    "elementDesc": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                },
                                "undistortionOffset": {
                                    "type": "GroupAttribute",
                                    "name": "undistortionOffset",
                                    "items": {
                                        "x": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        },
                                        "y": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        }
                                    }
                                },
                                "undistortionParams": {
                                    "type": "ListAttribute",
                                    "elementDesc": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                },
                                "locked": {
                                    "type": "BoolParam",
                                    "value": false
                                }
                            }
                        }
                    },
                    "sensorDatabase": {
                        "type": "File",
                        "value": "${ALICEVISION_SENSOR_DB}"
                    },
                    "lensCorrectionProfileInfo": {
                        "type": "File",
                        "value": "${ALICEVISION_LENS_PROFILE_INFO}"
                    },
                    "lensCorrectionProfileSearchIgnoreCameraModel": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "defaultFieldOfView": {
                        "type": "FloatParam",
                        "value": 45.0
                    },
                    "groupCameraFallback": {
                        "type": "ChoiceParam",
                        "value": "folder",
                        "values": [
                            "global",
                            "folder",
                            "image"
                        ]
                    },
                    "rawColorInterpretation": {
                        "type": "ChoiceParam",
                        "value": "DCPLinearProcessing",
                        "values": [
                            "None",
                            "LibRawNoWhiteBalancing",
                            "LibRawWhiteBalancing",
                            "DCPLinearProcessing",
                            "DCPMetadata",
                            "Auto"
                        ]
                    },
                    "colorProfileDatabase": {
                        "type": "File",
                        "value": "${ALICEVISION_COLOR_PROFILE_DB}"
                    },
                    "errorOnMissingColorProfile": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "viewIdMethod": {
                        "type": "ChoiceParam",
                        "value": "metadata",
                        "values": [
                            "metadata",
                            "filename"
                        ]
                    },
                    "viewIdRegex": {
                        "type": "StringParam",
                        "value": ".*?(\\d+)"
                    },
                    "isSequence": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/cameraInit.sfm"
                    }
                }
            }
        },
        "ConvertDistortion": {
            "1.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "from": {
                        "type": "ChoiceParam",
                        "value": "distortion",
                        "values": [
                            "distortion",
                            "undistortion"
                        ]
                    },
                    "to": {
                        "type": "ChoiceParam",
                        "value": "undistortion",
                        "values": [
                            "distortion",
                            "undistortion"
                        ]
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/sfm.usda"
                    }
                }
            }
        },
        "ConvertSfMFormat": {
            "2.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "fileExt": {
                        "type": "ChoiceParam",
                        "value": "usda",
                        "values": [
                            "abc",
                            "usda",
                            "sfm",
                            "json",
                            "ply",
                            "baf"
                        ]
                    },
                    "describerTypes": {
                        "type": "ChoiceParam",
                        "value": [
                            "dspsift"
                        ],
                        "values": [
                            "sift",
                            "sift_float",
                            "sift_upright",
                            "dspsift",
                            "akaze",
                            "akaze_liop",
                            "akaze_mldb",
                            "cctag3",
                            "cctag4",
                            "sift_ocv",
                            "akaze_ocv",
                            "tag16h5",
                            "survey",
                            "roma",
                            "unknown"
                        ],
                        "exclusive": false
                    },
                    "imageWhiteList": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "views": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "intrinsics": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "extrinsics": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "structure": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "observations": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "surveys": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/sfm.{fileExtValue}"
                    }
                }
            }
        },
        "CopyFiles": {
            "1.3": {
                "inputs": {
                    "inputFiles": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "output": {
                        "type": "File",
                        "value": ""
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {}
            }
        },
        "DepthMap": {
            "5.1": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "imagesFolder": {
                        "type": "File",
                        "value": ""
                    },
                    "downscale": {
                        "type": "ChoiceParam",
                        "value": 2,
                        "values": [
                            1,
                            2,
                            4,
                            8,
                            16
                        ]
                    },
                    "minViewAngle": {
                        "type": "FloatParam",
                        "value": 2.0
                    },
                    "maxViewAngle": {
                        "type": "FloatParam",
                        "value": 70.0
                    },
                    "tiling": {
                        "type": "GroupAttribute",
                        "name": "tiling",
                        "items": {
                            "tileBufferWidth": {
                                "type": "IntParam",
                                "value": 1024
                            },
                            "tileBufferHeight": {
                                "type": "IntParam",
                                "value": 1024
                            },
                            "tilePadding": {
                                "type": "IntParam",
                                "value": 64
                            },
                            "autoAdjustSmallImage": {
                                "type": "BoolParam",
                                "value": true
                            }
                        }
                    },
                    "chooseTCamsPerTile": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "maxTCams": {
                        "type": "IntParam",
                        "value": 10
                    },
                    "sgm": {
                        "type": "GroupAttribute",
                        "name": "sgm",
                        "items": {
                            "sgmScale": {
                                "type": "IntParam",
                                "value": 2
                            },
                            "sgmStepXY": {
                                "type": "IntParam",
                                "value": 2
                            },
                            "sgmStepZ": {
                                "type": "IntParam",
                                "value": -1
                            },
                            "sgmMaxTCamsPerTile": {
                                "type": "IntParam",
                                "value": 4
                            },
                            "sgmWSH": {
                                "type": "IntParam",
                                "value": 4
                            },
                            "sgmUseSfmSeeds": {
                                "type": "BoolParam",
                                "value": true
                            },
                            "sgmSeedsRangeInflate": {
                                "type": "FloatParam",
                                "value": 0.2
                            },
                            "sgmDepthThicknessInflate": {
                                "type": "FloatParam",
                                "value": 0.0
                            },
                            "sgmMaxSimilarity": {
                                "type": "FloatParam",
                                "value": 1.0
                            },
                            "sgmGammaC": {
                                "type": "FloatParam",
                                "value": 5.5
                            },
                            "sgmGammaP": {
                                "type": "FloatParam",
                                "value": 8.0
                            },
                            "sgmP1": {
                                "type": "FloatParam",
                                "value": 10.0
                            },
                            "sgmP2Weighting": {
                                "type": "FloatParam",
                                "value": 100.0
                            },
                            "sgmMaxDepths": {
                                "type": "IntParam",
                                "value": 1500
                            },
                            "sgmDepthListPerTile": {
                                "type": "BoolParam",
                                "value": true
                            },
                            "sgmUseConsistentScale": {
                                "type": "BoolParam",
                                "value": false
                            }
                        }
                    },
                    "refine": {
                        "type": "GroupAttribute",
                        "name": "refine",
                        "items": {
                            "refineEnabled": {
                                "type": "BoolParam",
                                "value": true
                            },
                            "refineScale": {
                                "type": "IntParam",
                                "value": 1
                            },
                            "refineStepXY": {
                                "type": "IntParam",
                                "value": 1
                            },
                            "refineMaxTCamsPerTile": {
                                "type": "IntParam",
                                "value": 4
                            },
                            "refineSubsampling": {
                                "type": "IntParam",
                                "value": 10
                            },
                            "refineHalfNbDepths": {
                                "type": "IntParam",
                                "value": 15
                            },
                            "refineWSH": {
                                "type": "IntParam",
                                "value": 3
                            },
                            "refineSigma": {
                                "type": "FloatParam",
                                "value": 15.0
                            },
                            "refineGammaC": {
                                "type": "FloatParam",
                                "value": 15.5
                            },
                            "refineGammaP": {
                                "type": "FloatParam",
                                "value": 8.0
                            },
                            "refineInterpolateMiddleDepth": {
                                "type": "BoolParam",
                                "value": false
                            },
                            "refineUseConsistentScale": {
                                "type": "BoolParam",
                                "value": false
                            }
                        }
                    },
                    "colorOptimization": {
                        "type": "GroupAttribute",
                        "name": "colorOptimization",
                        "items": {
                            "colorOptimizationEnabled": {
                                "type": "BoolParam",
                                "value": true
                            },
                            "colorOptimizationNbIterations": {
                                "type": "IntParam",
                                "value": 100
                            }
                        }
                    },
                    "customPatchPattern": {
                        "type": "GroupAttribute",
                        "name": "customPatchPattern",
                        "items": {
                            "sgmUseCustomPatchPattern": {
                                "type": "BoolParam",
                                "value": false
                            },
                            "refineUseCustomPatchPattern": {
                                "type": "BoolParam",
                                "value": false
                            },
                            "customPatchPatternSubparts": {
                                "type": "ListAttribute",
                                "elementDesc": {
                                    "type": "GroupAttribute",
                                    "name": "customPatchPatternSubpart",
                                    "items": {
                                        "customPatchPatternSubpartType": {
                                            "type": "ChoiceParam",
                                            "value": "full",
                                            "values": [
                                                "full",
                                                "circle"
                                            ]
                                        },
                                        "customPatchPatternSubpartRadius": {
                                            "type": "FloatParam",
                                            "value": 2.5
                                        },
                                        "customPatchPatternSubpartNbCoords": {
                                            "type": "IntParam",
                                            "value": 12
                                        },
                                        "customPatchPatternSubpartLevel": {
                                            "type": "IntParam",
                                            "value": 0
                                        },
                                        "customPatchPatternSubpartWeight": {
                                            "type": "FloatParam",
                                            "value": 1.0
                                        }
                                    }
                                }
                            },
                            "customPatchPatternGroupSubpartsPerLevel": {
                                "type": "BoolParam",
                                "value": false
                            }
                        }
                    },
                    "intermediateResults": {
                        "type": "GroupAttribute",
                        "name": "intermediateResults",
                        "items": {
                            "exportIntermediateDepthSimMaps": {
                                "type": "BoolParam",
                                "value": false
                            },
                            "exportIntermediateNormalMaps": {
                                "type": "BoolParam",
                                "value": false
                            },
                            "exportIntermediateVolumes": {
                                "type": "BoolParam",
                                "value": false
                            },
                            "exportIntermediateCrossVolumes": {
                                "type": "BoolParam",
                                "value": false
                            },
                            "exportIntermediateTopographicCutVolumes": {
                                "type": "BoolParam",
                                "value": false
                            },
                            "exportIntermediateVolume9pCsv": {
                                "type": "BoolParam",
                                "value": false
                            },
                            "exportTilePattern": {
                                "type": "BoolParam",
                                "value": false
                            }
                        }
                    },
                    "nbGPUs": {
                        "type": "IntParam",
                        "value": 0
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    },
                    "depth": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<VIEW_ID>_depthMap.exr"
                    },
                    "sim": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<VIEW_ID>_simMap.exr"
                    },
                    "tilePattern": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<VIEW_ID>_tilePattern.obj"
                    },
                    "depthSgm": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<VIEW_ID>_depthMap_sgm.exr"
                    },
                    "depthSgmUpscaled": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<VIEW_ID>_depthMap_sgmUpscaled.exr"
                    },
                    "depthRefined": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<VIEW_ID>_depthMap_refinedFused.exr"
                    }
                }
            }
        },
        "DepthMapFilter": {
            "4.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "depthMapsFolder": {
                        "type": "File",
                        "value": ""
                    },
                    "minViewAngle": {
                        "type": "FloatParam",
                        "value": 2.0
                    },
                    "maxViewAngle": {
                        "type": "FloatParam",
                        "value": 70.0
                    },
                    "nNearestCams": {
                        "type": "IntParam",
                        "value": 10
                    },
                    "minNumOfConsistentCams": {
                        "type": "IntParam",
                        "value": 3
                    },
                    "minNumOfConsistentCamsWithLowSimilarity": {
                        "type": "IntParam",
                        "value": 4
                    },
                    "pixToleranceFactor": {
                        "type": "FloatParam",
                        "value": 2.0
                    },
                    "pixSizeBall": {
                        "type": "IntParam",
                        "value": 0
                    },
                    "pixSizeBallWithLowSimilarity": {
                        "type": "IntParam",
                        "value": 0
                    },
                    "computeNormalMaps": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    },
                    "depth": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<VIEW_ID>_depthMap.exr"
                    },
                    "sim": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<VIEW_ID>_simMap.exr"
                    },
                    "normal": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<VIEW_ID>_normalMap.exr"
                    }
                }
            }
        },
        "ExportAlembic": {
            "1.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "frameRate": {
                        "type": "FloatParam",
                        "value": 24.0
                    },
                    "exportLandmarks": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/animated.abc"
                    }
                }
            }
        },
        "ExportDistortion": {
            "2.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "exportNukeNode": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "exportAnimatedNukeNode": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "exportLensGridsUndistorted": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "exportSTMaps": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    },
                    "distortionNukeNode": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/nukeLensDistortion_<INTRINSIC_ID>.nk"
                    },
                    "lensGridsUndistorted": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/lensgrid_<VIEW_ID>_undistort.exr"
                    },
                    "distortionStMap": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/stmap_<INTRINSIC_ID>_distort.exr"
                    },
                    "undistortionStMap": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/stmap_<INTRINSIC_ID>_undistort.exr"
                    }
                }
            }
        },
        "ExportImages": {
            "1.1": {
                "inputs": {
                    "input": {
