                        "type": "BoolParam",
                        "value": false
                    },
                    "seed": {
                        "type": "IntParam",
                        "value": 0
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
