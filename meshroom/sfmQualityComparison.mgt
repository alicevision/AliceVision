                        "type": "IntParam",
                        "value": 50000
                    },
                    "localizerEstimatorError": {
                        "type": "FloatParam",
                        "value": 0.0
                    },
                    "randomSeed": {
                        "type": "IntParam",
                        "value": 5489
                    },
