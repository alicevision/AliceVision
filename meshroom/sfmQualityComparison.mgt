                        "value": 1.0
                    },
                    "tscLand2ViewsRegWeight": {
                        "type": "FloatParam",
                        "value": 0.0
                    },
                    "tscTrajLengthRegWeight": {
                        "type": "FloatParam",
                        "value": 0.0
                    },
