                        "type": "IntParam",
                        "value": 50
                    },
                    "lockAllIntrinsics": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "enableStructureRefinement": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "enableObservationsWeighting": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "lossParameter": {
                        "type": "FloatParam",
                        "value": 16.0
                    },
                    "minNbCamerasToRefinePrincipalPoint": {
                        "type": "IntParam",
                        "value": 3
                    },
                    "useRigConstraint": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "rigMinNbCamerasForCalibration": {
                        "type": "IntParam",
                        "value": 20
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
