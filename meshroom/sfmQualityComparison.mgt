                        "type": "IntParam",
                        "value": 1
                    },
                    "nbFirstUnstableCameras": {
                        "type": "IntParam",
                        "value": 30
                    },
                    "maxImagesPerGroup": {
                        "type": "IntParam",
                        "value": 30
                    },
                    "bundleAdjustmentMaxOutliers": {
                        "type": "IntParam",
                        "value": 50
                    },
                    "weakResectionSize": {
                        "type": "IntParam",
                        "value": 100
                    },
                    "minNumberOfObservationsForTriangulation": {
                        "type": "IntParam",
                        "value": 2
                    },
                    "minAngleForTriangulation": {
                        "type": "FloatParam",
                        "value": 3.0
                    },
                    "minAngleForLandmark": {
                        "type": "FloatParam",
                        "value": 2.0
