{
    "header": {
        "releaseVersion": "2026.1.0+develop",
        "fileVersion": "2.2",
        "template": true
    },
    "nodeDescriptions": {
        "CameraInit": {
            "12.1": {
                "inputs": {
                    "viewpoints": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "GroupAttribute",
                            "name": "viewpoint",
                            "items": {
                                "viewId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "poseId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "path": {
                                    "type": "File",
                                    "value": ""
                                },
                                "intrinsicId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "rigId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "subPoseId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "metadata": {
                                    "type": "StringParam",
                                    "value": ""
                                }
                            }
                        }
                    },
                    "intrinsics": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "GroupAttribute",
                            "name": "intrinsic",
                            "items": {
                                "intrinsicId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "initialFocalLength": {
                                    "type": "FloatParam",
                                    "value": -1.0
                                },
                                "focalLength": {
                                    "type": "FloatParam",
                                    "value": 1000.0
                                },
                                "pixelRatio": {
                                    "type": "FloatParam",
                                    "value": 1.0
                                },
                                "pixelRatioLocked": {
                                    "type": "BoolParam",
                                    "value": true
                                },
                                "scaleLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "offsetLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "distortionLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "type": {
                                    "type": "ChoiceParam",
                                    "value": "pinhole",
                                    "values": [
                                        "pinhole",
                                        "equidistant",
                                        "equirectangular"
                                    ]
                                },
                                "distortionType": {
                                    "type": "ChoiceParam",
                                    "value": "radialk3",
                                    "values": [
                                        "none",
                                        "radialk1",
                                        "radialk3",
                                        "radialk3pt",
                                        "brown",
                                        "fisheye4",
                                        "fisheye1"
                                    ]
                                },
                                "width": {
                                    "type": "IntParam",
                                    "value": 0
                                },
                                "height": {
                                    "type": "IntParam",
                                    "value": 0
                                },
                                "sensorWidth": {
                                    "type": "FloatParam",
                                    "value": 36.0
                                },
                                "sensorHeight": {
                                    "type": "FloatParam",
                                    "value": 24.0
                                },
                                "serialNumber": {
                                    "type": "StringParam",
                                    "value": ""
                                },
                                "principalPoint": {
                                    "type": "GroupAttribute",
                                    "name": "principalPoint",
                                    "items": {
                                        "x": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        },
                                        "y": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        }
                                    }
                                },
                                "initializationMode": {
                                    "type": "ChoiceParam",
                                    "value": "none",
                                    "values": [
                                        "calibrated",
                                        "estimated",
                                        "unknown",
                                        "none"
                                    ]
                                },
                                "distortionInitializationMode": {
                                    "type": "ChoiceParam",
                                    "value": "none",
                                    "values": [
                                        "calibrated",
                                        "estimated",
                                        "unknown",
                                        "none"
                                    ]
                                },
                                "distortionParams": {
                                    "type": "ListAttribute",
                                    "elementDesc": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                },
                                "undistortionOffset": {
                                    "type": "GroupAttribute",
                                    "name": "undistortionOffset",
                                    "items": {
                                        "x": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        },
                                        "y": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        }
                                    }
                                },
                                "undistortionParams": {
                                    "type": "ListAttribute",
                                    "elementDesc": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                },
                                "locked": {
                                    "type": "BoolParam",
                                    "value": false
                                }
                            }
                        }
                    },
                    "sensorDatabase": {
                        "type": "File",
                        "value": "${ALICEVISION_SENSOR_DB}"
                    },
                    "lensCorrectionProfileInfo": {
                        "type": "File",
                        "value": "${ALICEVISION_LENS_PROFILE_INFO}"
                    },
                    "lensCorrectionProfileSearchIgnoreCameraModel": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "defaultFieldOfView": {
                        "type": "FloatParam",
                        "value": 45.0
                    },
                    "groupCameraFallback": {
                        "type": "ChoiceParam",
                        "value": "folder",
                        "values": [
                            "global",
                            "folder",
                            "image"
                        ]
                    },
                    "rawColorInterpretation": {
                        "type": "ChoiceParam",
                        "value": "DCPLinearProcessing",
                        "values": [
                            "None",
                            "LibRawNoWhiteBalancing",
                            "LibRawWhiteBalancing",
                            "DCPLinearProcessing",
                            "DCPMetadata",
                            "Auto"
                        ]
                    },
                    "colorProfileDatabase": {
                        "type": "File",
                        "value": "${ALICEVISION_COLOR_PROFILE_DB}"
                    },
                    "errorOnMissingColorProfile": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "viewIdMethod": {
                        "type": "ChoiceParam",
                        "value": "metadata",
                        "values": [
                            "metadata",
                            "filename"
                        ]
                    },
                    "viewIdRegex": {
                        "type": "StringParam",
                        "value": ".*?(\\d+)"
                    },
                    "isSequence": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/cameraInit.sfm"
                    }
                }
            }
        },
        "ConvertDistortion": {
            "1.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "from": {
                        "type": "ChoiceParam",
                        "value": "distortion",
                        "values": [
                            "distortion",
                            "undistortion"
                        ]
                    },
                    "to": {
                        "type": "ChoiceParam",
                        "value": "undistortion",
                        "values": [
                            "distortion",
                            "undistortion"
                        ]
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/sfm.usda"
                    }
                }
            }
        },
        "ConvertSfMFormat": {
            "2.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "fileExt": {
                        "type": "ChoiceParam",
                        "value": "usda",
                        "values": [
                            "abc",
                            "usda",
                            "sfm",
                            "json",
                            "ply",
                            "baf"
                        ]
                    },
                    "describerTypes": {
                        "type": "ChoiceParam",
                        "value": [
                            "dspsift"
                        ],
                        "values": [
                            "sift",
                            "sift_float",
                            "sift_upright",
                            "dspsift",
                            "akaze",
                            "akaze_liop",
                            "akaze_mldb",
                            "cctag3",
                            "cctag4",
                            "sift_ocv",
                            "akaze_ocv",
                            "tag16h5",
                            "survey",
                            "roma",
                            "unknown"
                        ],
                        "exclusive": false
                    },
                    "imageWhiteList": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "views": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "intrinsics": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "extrinsics": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "structure": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "observations": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "surveys": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/sfm.{fileExtValue}"
                    }
                }
            }
        },
        "CopyFiles": {
            "1.3": {
                "inputs": {
                    "inputFiles": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "output": {
                        "type": "File",
                        "value": ""
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {}
            }
        },
        "ExportAlembic": {
            "1.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "frameRate": {
                        "type": "FloatParam",
                        "value": 24.0
                    },
                    "exportLandmarks": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/animated.abc"
                    }
                }
            }
        },
        "ExportDistortion": {
            "2.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "exportNukeNode": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "exportAnimatedNukeNode": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "exportLensGridsUndistorted": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "exportSTMaps": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    },
                    "distortionNukeNode": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/nukeLensDistortion_<INTRINSIC_ID>.nk"
                    },
                    "lensGridsUndistorted": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/lensgrid_<VIEW_ID>_undistort.exr"
                    },
                    "distortionStMap": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/stmap_<INTRINSIC_ID>_distort.exr"
                    },
                    "undistortionStMap": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/stmap_<INTRINSIC_ID>_undistort.exr"
                    }
                }
            }
        },
        "ExportImages": {
            "1.1": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "target": {
                        "type": "File",
                        "value": ""
                    },
                    "masksFolders": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "outputFileType": {
                        "type": "ChoiceParam",
                        "value": "exr",
                        "values": [
                            "jpg",
                            "png",
                            "tif",
                            "exr"
                        ]
                    },
                    "evCorrection": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "exportFullROD": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "namingMode": {
                        "type": "ChoiceParam",
                        "value": "viewid",
                        "values": [
                            "viewid",
                            "frameid",
                            "keep"
                        ]
                    },
                    "maskExtension": {
                        "type": "ChoiceParam",
                        "value": "png",
                        "values": [
                            "exr",
                            "jpg",
                            "png"
                        ]
                    },
                    "storageDataType": {
                        "type": "ChoiceParam",
                        "value": "halfFinite",
                        "values": [
                            "float",
                            "half",
                            "halfFinite",
                            "auto"
                        ]
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    },
                    "undistorted": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<FILESTEM>.{outputFileTypeValue}"
                    },
                    "outputSfMData": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/sfm.usda"
                    }
                }
            }
        },
        "FeatureExtraction": {
            "1.3": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "masksFolder": {
                        "type": "File",
                        "value": ""
                    },
                    "maskExtension": {
                        "type": "ChoiceParam",
                        "value": "png",
                        "values": [
                            "png",
                            "exr",
                            "jpg"
                        ]
                    },
                    "maskInvert": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "describerTypes": {
                        "type": "ChoiceParam",
                        "value": [
                            "dspsift"
                        ],
                        "values": [
                            "sift",
                            "sift_float",
                            "sift_upright",
                            "dspsift",
                            "akaze",
                            "akaze_liop",
                            "akaze_mldb",
                            "cctag3",
                            "cctag4",
                            "sift_ocv",
                            "akaze_ocv",
                            "tag16h5",
                            "survey",
                            "roma",
                            "unknown"
                        ],
                        "exclusive": false
                    },
                    "describerPreset": {
                        "type": "ChoiceParam",
                        "value": "normal",
                        "values": [
                            "low",
                            "medium",
                            "normal",
                            "high",
                            "ultra",
                            "custom"
                        ]
                    },
                    "maxNbFeatures": {
                        "type": "IntParam",
                        "value": 0
                    },
                    "describerQuality": {
                        "type": "ChoiceParam",
                        "value": "normal",
                        "values": [
                            "low",
                            "medium",
                            "normal",
                            "high",
                            "ultra"
                        ]
                    },
                    "contrastFiltering": {
                        "type": "ChoiceParam",
                        "value": "GridSort",
                        "values": [
                            "Static",
                            "AdaptiveToMedianVariance",
                            "NoFiltering",
                            "GridSortOctaves",
                            "GridSort",
                            "GridSortScaleSteps",
                            "GridSortOctaveSteps",
                            "NonExtremaFiltering"
                        ]
                    },
                    "relativePeakThreshold": {
                        "type": "FloatParam",
                        "value": 0.01
                    },
                    "gridFiltering": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "workingColorSpace": {
                        "type": "ChoiceParam",
                        "value": "sRGB",
                        "values": [
                            "AUTO",
                            "sRGB",
                            "rec709",
                            "Linear",
                            "ACES2065-1",
                            "ACEScg",
                            "Linear ARRI Wide Gamut 3",
                            "ARRI LogC3 (EI800)",
                            "Linear ARRI Wide Gamut 4",
                            "ARRI LogC4",
                            "Linear BMD WideGamut Gen5",
                            "BMDFilm WideGamut Gen5",
                            "CanonLog2 CinemaGamut D55",
                            "CanonLog3 CinemaGamut D55",
                            "Linear CinemaGamut D55",
                            "Linear V-Gamut",
                            "V-Log V-Gamut",
                            "Linear REDWideGamutRGB",
                            "Log3G10 REDWideGamutRGB",
                            "Linear Venice S-Gamut3.Cine",
                            "S-Log3 Venice S-Gamut3.Cine",
                            "no_conversion"
                        ]
                    },
                    "forceCpuExtraction": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "maxThreads": {
                        "type": "IntParam",
                        "value": 0
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    }
                }
            }
        },
        "FeatureMatching": {
            "2.1": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "featuresFolders": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "imagePairsList": {
                        "type": "File",
                        "value": ""
                    },
                    "describerTypes": {
                        "type": "ChoiceParam",
                        "value": [
                            "dspsift"
                        ],
                        "values": [
                            "sift",
                            "sift_float",
                            "sift_upright",
                            "dspsift",
                            "akaze",
                            "akaze_liop",
                            "akaze_mldb",
                            "cctag3",
                            "cctag4",
                            "sift_ocv",
                            "akaze_ocv",
                            "tag16h5",
                            "survey",
                            "roma",
                            "unknown"
                        ],
                        "exclusive": false
                    },
                    "photometricMatchingMethod": {
                        "type": "ChoiceParam",
                        "value": "ANN_L2",
                        "values": [
                            "BRUTE_FORCE_L2",
                            "ANN_L2",
                            "CASCADE_HASHING_L2",
                            "FAST_CASCADE_HASHING_L2",
                            "BRUTE_FORCE_HAMMING"
                        ]
                    },
                    "geometricEstimator": {
                        "type": "ChoiceParam",
                        "value": "acransac",
                        "values": [
                            "acransac",
                            "loransac"
                        ]
                    },
                    "geometricFilterType": {
                        "type": "ChoiceParam",
                        "value": "fundamental_matrix",
                        "values": [
                            "fundamental_matrix",
                            "fundamental_with_distortion",
                            "essential_matrix",
                            "homography_matrix",
                            "homography_growing",
                            "no_filtering"
                        ]
                    },
                    "distanceRatio": {
                        "type": "FloatParam",
                        "value": 0.8
                    },
                    "maxIteration": {
                        "type": "IntParam",
                        "value": 50000
                    },
                    "geometricError": {
                        "type": "FloatParam",
                        "value": 0.0
                    },
                    "knownPosesGeometricErrorMax": {
                        "type": "FloatParam",
                        "value": 5.0
                    },
                    "minRequired2DMotion": {
                        "type": "FloatParam",
                        "value": -1.0
                    },
                    "maxMatches": {
                        "type": "IntParam",
                        "value": 0
                    },
                    "savePutativeMatches": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "crossMatching": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "guidedMatching": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "matchFromKnownCameraPoses": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "exportDebugFiles": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    }
                }
            }
        },
        "ImageMatching": {
            "2.1": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "featuresFolders": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "method": {
                        "type": "ChoiceParam",
                        "value": "SequentialAndVocabularyTree",
                        "values": [
                            "VocabularyTree",
                            "Sequential",
                            "SequentialAndVocabularyTree",
                            "Exhaustive",
                            "Frustum",
                            "FrustumOrVocabularyTree",
                            "Mirror"
                        ]
                    },
                    "tree": {
                        "type": "File",
                        "value": "${ALICEVISION_VOCTREE}"
                    },
                    "weights": {
                        "type": "File",
                        "value": ""
                    },
                    "minNbImages": {
                        "type": "IntParam",
                        "value": 200
                    },
                    "maxDescriptors": {
                        "type": "IntParam",
                        "value": 500
                    },
                    "nbMatches": {
                        "type": "IntParam",
                        "value": 40
                    },
                    "nbNeighbors": {
                        "type": "IntParam",
                        "value": 5
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/imageMatches.txt"
                    }
                }
            }
        },
        "ImageSegmentationSam3": {
            "2.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "prompt": {
                        "type": "StringParam",
                        "value": "person\nchild\npeople"
                    },
                    "bboxFolder": {
                        "type": "File",
                        "value": ""
                    },
                    "segmentationModelPath": {
                        "type": "File",
                        "value": "${RDS_SAM3_MODEL_PATH}"
                    },
                    "enableBonding": {
                        "type": "BoolParam",
                        "value": true
