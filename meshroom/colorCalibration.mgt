{
    "header": {
        "releaseVersion": "2026.1.0+develop",
        "fileVersion": "2.2",
        "template": true
    },
    "nodeDescriptions": {
        "CameraInit": {
            "12.1": {
                "inputs": {
                    "viewpoints": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "GroupAttribute",
                            "name": "viewpoint",
                            "items": {
                                "viewId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "poseId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "path": {
                                    "type": "File",
                                    "value": ""
                                },
                                "intrinsicId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "rigId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "subPoseId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "metadata": {
                                    "type": "StringParam",
                                    "value": ""
                                }
                            }
                        }
                    },
                    "intrinsics": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "GroupAttribute",
                            "name": "intrinsic",
                            "items": {
                                "intrinsicId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "initialFocalLength": {
                                    "type": "FloatParam",
                                    "value": -1.0
                                },
                                "focalLength": {
                                    "type": "FloatParam",
                                    "value": 1000.0
                                },
                                "pixelRatio": {
                                    "type": "FloatParam",
                                    "value": 1.0
                                },
                                "pixelRatioLocked": {
                                    "type": "BoolParam",
                                    "value": true
                                },
                                "scaleLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "offsetLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "distortionLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "type": {
                                    "type": "ChoiceParam",
                                    "value": "pinhole",
                                    "values": [
                                        "pinhole",
                                        "equidistant",
                                        "equirectangular"
                                    ]
                                },
                                "distortionType": {
                                    "type": "ChoiceParam",
                                    "value": "radialk3",
                                    "values": [
                                        "none",
                                        "radialk1",
                                        "radialk3",
                                        "radialk3pt",
                                        "brown",
                                        "fisheye4",
                                        "fisheye1"
                                    ]
                                },
                                "width": {
                                    "type": "IntParam",
                                    "value": 0
                                },
                                "height": {
                                    "type": "IntParam",
                                    "value": 0
                                },
                                "sensorWidth": {
                                    "type": "FloatParam",
                                    "value": 36.0
                                },
                                "sensorHeight": {
                                    "type": "FloatParam",
                                    "value": 24.0
                                },
                                "serialNumber": {
                                    "type": "StringParam",
                                    "value": ""
                                },
                                "principalPoint": {
                                    "type": "GroupAttribute",
                                    "name": "principalPoint",
                                    "items": {
                                        "x": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        },
                                        "y": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        }
                                    }
                                },
                                "initializationMode": {
                                    "type": "ChoiceParam",
                                    "value": "none",
                                    "values": [
                                        "calibrated",
                                        "estimated",
                                        "unknown",
                                        "none"
                                    ]
                                },
                                "distortionInitializationMode": {
                                    "type": "ChoiceParam",
                                    "value": "none",
                                    "values": [
                                        "calibrated",
                                        "estimated",
                                        "unknown",
                                        "none"
                                    ]
                                },
                                "distortionParams": {
                                    "type": "ListAttribute",
                                    "elementDesc": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                },
                                "undistortionOffset": {
                                    "type": "GroupAttribute",
                                    "name": "undistortionOffset",
                                    "items": {
                                        "x": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        },
                                        "y": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        }
                                    }
                                },
                                "undistortionParams": {
                                    "type": "ListAttribute",
                                    "elementDesc": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                },
                                "locked": {
                                    "type": "BoolParam",
                                    "value": false
                                }
                            }
                        }
                    },
                    "sensorDatabase": {
                        "type": "File",
                        "value": "${ALICEVISION_SENSOR_DB}"
                    },
                    "lensCorrectionProfileInfo": {
                        "type": "File",
                        "value": "${ALICEVISION_LENS_PROFILE_INFO}"
                    },
                    "lensCorrectionProfileSearchIgnoreCameraModel": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "defaultFieldOfView": {
                        "type": "FloatParam",
                        "value": 45.0
                    },
                    "groupCameraFallback": {
                        "type": "ChoiceParam",
                        "value": "folder",
                        "values": [
                            "global",
                            "folder",
                            "image"
                        ]
                    },
                    "rawColorInterpretation": {
                        "type": "ChoiceParam",
                        "value": "DCPLinearProcessing",
                        "values": [
                            "None",
                            "LibRawNoWhiteBalancing",
                            "LibRawWhiteBalancing",
                            "DCPLinearProcessing",
                            "DCPMetadata",
                            "Auto"
                        ]
                    },
                    "colorProfileDatabase": {
                        "type": "File",
                        "value": "${ALICEVISION_COLOR_PROFILE_DB}"
                    },
                    "errorOnMissingColorProfile": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "viewIdMethod": {
                        "type": "ChoiceParam",
                        "value": "metadata",
                        "values": [
                            "metadata",
                            "filename"
                        ]
                    },
                    "viewIdRegex": {
                        "type": "StringParam",
                        "value": ".*?(\\d+)"
                    },
                    "isSequence": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/cameraInit.sfm"
                    }
                }
            }
        },
        "ColorCheckerCorrection": {
            "2.0": {
                "inputs": {
                    "inputData": {
                        "type": "File",
                        "value": ""
                    },
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "correctionMethod": {
                        "type": "ChoiceParam",
                        "value": "luminance",
                        "values": [
                            "luminance",
                            "whiteBalance",
                            "full",
                            "bypass"
                        ]
                    },
                    "useBestColorCheckerOnly": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "keepImageName": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "extension": {
                        "type": "ChoiceParam",
                        "value": "exr",
                        "values": [
                            "exr",
                            ""
                        ]
                    },
                    "storageDataType": {
                        "type": "ChoiceParam",
                        "value": "float",
                        "values": [
                            "float",
                            "half",
                            "halfFinite",
                            "auto"
                        ]
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "outSfMData": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/cameraInit.sfm"
                    },
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    },
                    "outputImages": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<VIEW_ID>.exr"
                    }
                }
            }
        },
        "ColorCheckerDetection": {
            "2.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "ccType": {
                        "type": "ChoiceParam",
                        "value": "mcc24",
                        "values": [
                            "mcc24",
                            "sg140",
                            "Vinyl18"
                        ]
                    },
                    "modelFolder": {
                        "type": "File",
                        "value": "${ALICEVISION_COLORCHARTDETECTION_MODEL_FOLDER}"
                    },
                    "maxCount": {
                        "type": "IntParam",
                        "value": 1
                    },
                    "debug": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "processAllImages": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "filter": {
                        "type": "File",
                        "value": "*_macbeth.*"
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "outputData": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/ccheckers.json"
                    }
                }
            }
        },
        "CopyFiles": {
            "1.3": {
                "inputs": {
                    "inputFiles": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "output": {
                        "type": "File",
                        "value": ""
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {}
            }
        }
    },
    "graph": {
        "CameraInit_1": {
            "nodeType": "CameraInit",
            "version": "12.1",
            "position": [
                -309,
                -26
            ],
            "inputs": {}
        },
        "ColorCheckerCorrection_1": {
            "nodeType": "ColorCheckerCorrection",
            "version": "2.0",
            "position": [
                87,
                -24
            ],
            "inputs": {
                "inputData": "{ColorCheckerDetection_1.outputData}",
                "input": "{ColorCheckerDetection_1.input}",
                "correctionMethod": "full",
                "keepImageName": false
            }
        },
        "ColorCheckerDetection_1": {
            "nodeType": "ColorCheckerDetection",
            "version": "2.0",
            "position": [
                -108,
                -19
            ],
            "inputs": {
                "input": "{CameraInit_1.output}"
            }
        },
        "CopyFiles_1": {
            "nodeType": "CopyFiles",
            "version": "1.3",
            "position": [
                279,
                -10
            ],
            "inputs": {
                "inputFiles": [
                    "{ColorCheckerCorrection_1.output}"
                ]
            }
        }
    }
}