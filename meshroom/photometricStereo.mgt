{
    "header": {
        "releaseVersion": "2026.1.0+develop",
        "fileVersion": "2.2",
        "template": true
    },
    "nodeDescriptions": {
        "CameraInit": {
            "12.1": {
                "inputs": {
                    "viewpoints": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "GroupAttribute",
                            "name": "viewpoint",
                            "items": {
                                "viewId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "poseId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "path": {
                                    "type": "File",
                                    "value": ""
                                },
                                "intrinsicId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "rigId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "subPoseId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "metadata": {
                                    "type": "StringParam",
                                    "value": ""
                                }
                            }
                        }
                    },
                    "intrinsics": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "GroupAttribute",
                            "name": "intrinsic",
                            "items": {
                                "intrinsicId": {
                                    "type": "IntParam",
                                    "value": -1
                                },
                                "initialFocalLength": {
                                    "type": "FloatParam",
                                    "value": -1.0
                                },
                                "focalLength": {
                                    "type": "FloatParam",
                                    "value": 1000.0
                                },
                                "pixelRatio": {
                                    "type": "FloatParam",
                                    "value": 1.0
                                },
                                "pixelRatioLocked": {
                                    "type": "BoolParam",
                                    "value": true
                                },
                                "scaleLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "offsetLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "distortionLocked": {
                                    "type": "BoolParam",
                                    "value": false
                                },
                                "type": {
                                    "type": "ChoiceParam",
                                    "value": "pinhole",
                                    "values": [
                                        "pinhole",
                                        "equidistant",
                                        "equirectangular"
                                    ]
                                },
                                "distortionType": {
                                    "type": "ChoiceParam",
                                    "value": "radialk3",
                                    "values": [
                                        "none",
                                        "radialk1",
                                        "radialk3",
                                        "radialk3pt",
                                        "brown",
                                        "fisheye4",
                                        "fisheye1"
                                    ]
                                },
                                "width": {
                                    "type": "IntParam",
                                    "value": 0
                                },
                                "height": {
                                    "type": "IntParam",
                                    "value": 0
                                },
                                "sensorWidth": {
                                    "type": "FloatParam",
                                    "value": 36.0
                                },
                                "sensorHeight": {
                                    "type": "FloatParam",
                                    "value": 24.0
                                },
                                "serialNumber": {
                                    "type": "StringParam",
                                    "value": ""
                                },
                                "principalPoint": {
                                    "type": "GroupAttribute",
                                    "name": "principalPoint",
                                    "items": {
                                        "x": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        },
                                        "y": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        }
                                    }
                                },
                                "initializationMode": {
                                    "type": "ChoiceParam",
                                    "value": "none",
                                    "values": [
                                        "calibrated",
                                        "estimated",
                                        "unknown",
                                        "none"
                                    ]
                                },
                                "distortionInitializationMode": {
                                    "type": "ChoiceParam",
                                    "value": "none",
                                    "values": [
                                        "calibrated",
                                        "estimated",
                                        "unknown",
                                        "none"
                                    ]
                                },
                                "distortionParams": {
                                    "type": "ListAttribute",
                                    "elementDesc": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                },
                                "undistortionOffset": {
                                    "type": "GroupAttribute",
                                    "name": "undistortionOffset",
                                    "items": {
                                        "x": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        },
                                        "y": {
                                            "type": "FloatParam",
                                            "value": 0.0
                                        }
                                    }
                                },
                                "undistortionParams": {
                                    "type": "ListAttribute",
                                    "elementDesc": {
                                        "type": "FloatParam",
                                        "value": 0.0
                                    }
                                },
                                "locked": {
                                    "type": "BoolParam",
                                    "value": false
                                }
                            }
                        }
                    },
                    "sensorDatabase": {
                        "type": "File",
                        "value": "${ALICEVISION_SENSOR_DB}"
                    },
                    "lensCorrectionProfileInfo": {
                        "type": "File",
                        "value": "${ALICEVISION_LENS_PROFILE_INFO}"
                    },
                    "lensCorrectionProfileSearchIgnoreCameraModel": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "defaultFieldOfView": {
                        "type": "FloatParam",
                        "value": 45.0
                    },
                    "groupCameraFallback": {
                        "type": "ChoiceParam",
                        "value": "folder",
                        "values": [
                            "global",
                            "folder",
                            "image"
                        ]
                    },
                    "rawColorInterpretation": {
                        "type": "ChoiceParam",
                        "value": "DCPLinearProcessing",
                        "values": [
                            "None",
                            "LibRawNoWhiteBalancing",
                            "LibRawWhiteBalancing",
                            "DCPLinearProcessing",
                            "DCPMetadata",
                            "Auto"
                        ]
                    },
                    "colorProfileDatabase": {
                        "type": "File",
                        "value": "${ALICEVISION_COLOR_PROFILE_DB}"
                    },
                    "errorOnMissingColorProfile": {
                        "type": "BoolParam",
                        "value": true
                    },
                    "viewIdMethod": {
                        "type": "ChoiceParam",
                        "value": "metadata",
                        "values": [
                            "metadata",
                            "filename"
                        ]
                    },
                    "viewIdRegex": {
                        "type": "StringParam",
                        "value": ".*?(\\d+)"
                    },
                    "isSequence": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/cameraInit.sfm"
                    }
                }
            }
        },
        "CopyFiles": {
            "1.3": {
                "inputs": {
                    "inputFiles": {
                        "type": "ListAttribute",
                        "elementDesc": {
                            "type": "File",
                            "value": ""
                        }
                    },
                    "output": {
                        "type": "File",
                        "value": ""
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {}
            }
        },
        "LightingCalibration": {
            "1.0": {
                "inputs": {
                    "inputPath": {
                        "type": "File",
                        "value": ""
                    },
                    "inputDetection": {
                        "type": "File",
                        "value": ""
                    },
                    "saveAsModel": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "ellipticEstimation": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "method": {
                        "type": "ChoiceParam",
                        "value": "brightestPoint",
                        "values": [
                            "brightestPoint",
                            "whiteSphere",
                            "SH"
                        ]
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "outputFile": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/lights.json"
                    },
                    "lightingEstimationVisualization": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<FILESTEM>_{methodValue}.png"
                    }
                }
            }
        },
        "PhotometricStereo": {
            "1.0": {
                "inputs": {
                    "inputPath": {
                        "type": "File",
                        "value": ""
                    },
                    "pathToJSONLightFile": {
                        "type": "File",
                        "value": "defaultJSON.txt"
                    },
                    "maskPath": {
                        "type": "File",
                        "value": ""
                    },
                    "SHOrder": {
                        "type": "ChoiceParam",
                        "value": "0",
                        "values": [
                            "0",
                            "1",
                            "2"
                        ]
                    },
                    "removeAmbient": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "isRobust": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "downscale": {
                        "type": "IntParam",
                        "value": 1
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "outputPath": {
                        "type": "File",
                        "value": "{nodeCacheFolder}"
                    },
                    "outputSfmDataAlbedo": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/albedoMaps.sfm"
                    },
                    "outputSfmDataNormal": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/normalMaps.sfm"
                    },
                    "outputSfmDataNormalPNG": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/normalMapsPNG.sfm"
                    },
                    "normals": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<POSE_ID>_normals.exr"
                    },
                    "normalsPNG": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<POSE_ID>_normals.png"
                    },
                    "normalsWorld": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<POSE_ID>_normals_w.exr"
                    },
                    "albedo": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/<POSE_ID>_albedo.png"
                    }
                }
            }
        },
        "SphereDetection": {
            "2.0": {
                "inputs": {
                    "input": {
                        "type": "File",
                        "value": ""
                    },
                    "modelPath": {
                        "type": "File",
                        "value": "${ALICEVISION_SPHERE_DETECTION_MODEL}"
                    },
                    "autoDetect": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "sphereShape": {
                        "type": "Circle",
                        "name": "sphereShape",
                        "keyable": true
                    },
                    "sphereFile": {
                        "type": "File",
                        "value": ""
                    },
                    "fillMissingSpheres": {
                        "type": "BoolParam",
                        "value": false
                    },
                    "minScore": {
                        "type": "FloatParam",
                        "value": 0.0
                    },
                    "verboseLevel": {
                        "type": "ChoiceParam",
                        "value": "info",
                        "values": [
                            "fatal",
                            "error",
                            "warning",
                            "info",
                            "debug",
                            "trace"
                        ]
                    }
                },
                "outputs": {
                    "output": {
                        "type": "File",
                        "value": "{nodeCacheFolder}/detection.json"
                    }
                }
            }
        }
    },
    "graph": {
        "CameraInit_1": {
            "nodeType": "CameraInit",
            "version": "12.1",
            "position": [
                0,
                0
            ],
            "inputs": {}
        },
        "CopyFiles_1": {
            "nodeType": "CopyFiles",
            "version": "1.3",
            "position": [
                800,
                0
            ],
            "inputs": {
                "inputFiles": [
                    "{PhotometricStereo_1.outputSfmDataNormal}",
                    "{PhotometricStereo_1.normals}",
                    "{PhotometricStereo_1.normalsWorld}",
                    "{PhotometricStereo_1.albedo}",
                    "{PhotometricStereo_1.outputSfmDataAlbedo}",
                    "{PhotometricStereo_1.inputPath}",
                    "{PhotometricStereo_1.outputSfmDataNormalPNG}",
                    "{PhotometricStereo_1.normalsPNG}",
                    "{PhotometricStereo_1.pathToJSONLightFile}"
                ]
            }
        },
        "LightingCalibration_1": {
            "nodeType": "LightingCalibration",
            "version": "1.0",
            "position": [
                400,
                0
            ],
            "inputs": {
                "inputPath": "{SphereDetection_1.input}",
                "inputDetection": "{SphereDetection_1.output}"
            }
        },
        "PhotometricStereo_1": {
            "nodeType": "PhotometricStereo",
            "version": "1.0",
            "position": [
                600,
                0
            ],
            "inputs": {
                "inputPath": "{LightingCalibration_1.inputPath}",
                "pathToJSONLightFile": "{LightingCalibration_1.outputFile}"
            }
        },
        "SphereDetection_1": {
            "nodeType": "SphereDetection",
            "version": "2.0",
            "position": [
                200,
                0
            ],
            "inputs": {
                "input": "{CameraInit_1.output}",
                "autoDetect": true
            }
        }
    }
}